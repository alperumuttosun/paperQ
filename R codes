addWorksheet(wb, "partA_baseline_weight_vs_main")
writeData(wb, "partA_baseline_weight_vs_main", comparison_table)
addWorksheet(wb, "partB_tmx_irr_interaction")
writeData(wb, "partB_tmx_irr_interaction", partB_results)
addWorksheet(wb, "partB_low_vs_high_irr_test")
writeData(wb, "partB_low_vs_high_irr_test", partB_gap_test)
saveWorkbook(wb, file.path(out_dir, "step07_baseline_weight_and_irr_interaction.xlsx"),
             overwrite = TRUE)


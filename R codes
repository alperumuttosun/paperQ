# ==============================================================================
# QUANTILE STEP 02 — Scale regression (Machado & Santos Silva 2019, Step 2)
# Paper_Quantile
# ==============================================================================
# Goal: regress |resid_mean| (absolute value of the mean-regression residual from
# Step 01) on the SAME right-hand-side variables as the mean equation, with the same country +
# year fixed effects. This tells us how much each variable (especially TMX_c)
# moves the SPREAD/VOLATILITY of yield outcomes, not just the average.
#
# Why absolute value and not squared: Machado & Santos Silva's (2019) own
# identifying assumption is E[u_it] = 0 and E[|u_it|] = 1 (confirmed via
# Kumar & Khanna 2023's working paper, which states this explicitly). Using
# |resid| keeps us aligned with both the original method and our closest
# benchmark study.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(openxlsx)

# --- 1. Load Step 01 output -----------------------------------------------------
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

panels <- readRDS(file.path(out_dir, "step01_residual_panels.rds"))

# --- 2. Build the absolute-residual variable -------------------------------------
# Only rows with a non-missing resid_mean (i.e., rows actually used in the mean equation) can
# enter the scale regression — rows dropped in Step 01 for missing GDP etc.
# stay dropped here too, for consistency.
add_abs_resid <- function(df) {
  df %>% mutate(abs_resid_mean = abs(resid_mean))
}
panels <- map(panels, add_abs_resid)

# --- 3. Run the scale regression per crop -----------------------------------------
# Same RHS + same FE structure as the mean equation, but the outcome is |resid_mean| instead of
# ln_yield. The coefficients here (gamma_hat) tell us how TMX_c, PRE_c, irr_ratio,
# and ln_gdp affect the SIZE of deviations from the mean-predicted yield — this
# is the "scale" part of the MSS location-scale model (Section on algorithm,
# Adım 1: y_it = alpha_i + X*beta + (delta_i + Z*gamma) * eps_it).
run_scale_model <- function(crop) {
  df <- panels[[crop]]
  # drop rows where resid_mean is NA (same sample as the mean-equation model in Step 01)
  df_est <- df %>% filter(!is.na(abs_resid_mean))
  
  mod <- feols(
    abs_resid_mean ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes,
    cluster = ~country,
    data = df_est
  )
  
  # fitted values = the estimated "scale" (gamma_hat term) for each observation;
  # this becomes the denominator used to standardize residuals in Step 03.
  # country+year is a unique key in these panels, so a join is a safe way to
  # reattach fitted values without relying on row-position bookkeeping.
  used_rows <- obs(mod)
  df_est$scale_hat <- NA_real_
  df_est$scale_hat[used_rows] <- fitted(mod)
  
  df <- df %>%
    left_join(
      df_est %>% select(country, year, scale_hat),
      by = c("country", "year")
    )
  
  list(model = mod, data = df)
}

scale_results <- map(crops, run_scale_model) %>% setNames(crops)

# --- 4. Quick look: TMX_c coefficient in the scale regression per crop -------------
# Interpretation: a NEGATIVE coefficient here means higher TMX is associated with
# SMALLER absolute deviations (more stable yields under heat); a POSITIVE
# coefficient means higher TMX is associated with LARGER deviations (more
# volatile/unstable yields under heat) — this is new information the mean equation alone
# cannot give us.
scale_check <- map_dfr(crops, function(crop) {
  mod <- scale_results[[crop]]$model
  data.frame(
    crop           = crop,
    TMX_scale_coef = coef(mod)["TMX_c"],
    TMX_scale_se   = se(mod)["TMX_c"],
    n_obs          = mod$nobs
  )
})
print(scale_check)

# --- 5. Sanity check: scale_hat should be strictly positive -----------------------
# Fitted |resid| values can technically go negative in a linear model (a known
# quirk of regressing an absolute value linearly) — flag if this happens, since
# Step 03 will divide by scale_hat and a non-positive denominator breaks it.
scale_negativity_check <- map_dfr(crops, function(crop) {
  df <- scale_results[[crop]]$data
  n_neg <- sum(df$scale_hat <= 0, na.rm = TRUE)
  n_valid <- sum(!is.na(df$scale_hat))
  data.frame(crop = crop, n_nonpositive_scale = n_neg, n_valid_scale = n_valid)
})
print(scale_negativity_check)
# If n_nonpositive_scale > 0 for any crop, we'll need to floor scale_hat at a
# small positive value before Step 03 — flagging here rather than silently
# patching it, so we look at how many rows are affected first.

# --- 6. Save output for Step 03 ----------------------------------------------------
scale_panels <- map(scale_results, "data")
saveRDS(scale_panels, file.path(out_dir, "step02_scale_panels.rds"))

wb <- createWorkbook()
walk(crops, function(crop) {
  addWorksheet(wb, crop)
  writeData(wb, crop, scale_panels[[crop]])
})
addWorksheet(wb, "scale_check")
writeData(wb, "scale_check", scale_check)
addWorksheet(wb, "scale_negativity_check")
writeData(wb, "scale_negativity_check", scale_negativity_check)

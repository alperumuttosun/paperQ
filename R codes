  }
  
  n_total  <- nrow(df)
  n_zero   <- sum(df$PET_ann == 0, na.rm = TRUE)
  n_na     <- sum(is.na(df$PET_ann))
  n_out    <- sum(!is.na(df$PET_ann) & (df$PET_ann < 0 | df$PET_ann > 3000))
  

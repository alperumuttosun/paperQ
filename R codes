# ==============================================================================
# QUANTILE STEP 11 — Multiple-testing correction for the irrigation-interaction
#                     results (Step 07 Part B)
# ==============================================================================
# Rationale: Step 07 Part B tested 40 hypotheses (8 crops x 5 quantiles) for
# whether low-vs-high equipped-irrigation changes TMX's effect. Wheat, maize,
# and rice showed significant results WITHOUT any correction for running 40
# tests at once. Since irrigation buffering is now the paper's central claim,
# this correction is not optional: we need to know whether wheat/maize/rice
# survive a formal multiple-testing adjustment, or whether their significance
# is partly an artifact of testing many hypotheses without correction.
#
# Two corrections are applied, since they make different assumptions and
# reviewers may ask for either:
#   (1) Benjamini-Hochberg FDR — controls the expected proportion of false
#       discoveries among rejected hypotheses. Standard, easy to justify,
#       reasonably conservative.
#   (2) Romano-Wolf stepdown — a bootstrap-based procedure that controls the
#       family-wise error rate while accounting for the CORRELATION between
#       tests (the 5 quantiles within a crop are not independent tests, since
#       they come from the same underlying bootstrap distribution). This is
#       more appropriate here than a naive Bonferroni correction, which
#       assumes independence and would be needlessly conservative given how
#       correlated the 5 within-crop quantile tests actually are.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)

# --- 1. Load Step 07's saved results (has both the p-values AND the raw ---------
#         bootstrap replications needed for Romano-Wolf) --------------------------
step07 <- readRDS(file.path(out_dir, "step07_baseline_weight_and_irr_interaction.rds"))
gap_test <- step07$partB_gap_test         # crop, tau, low_minus_high, boot_se_diff, p_value_boot
partB_boot <- step07$partB_boot           # list of {boot_low, boot_high} matrices, per crop

# --- 2. Benjamini-Hochberg FDR correction ----------------------------------------
# Applied across ALL 40 crop-quantile cells at once (the full family of tests
# reported in the paper for this interaction), not separately per crop — this
# is the conservative, defensible choice: if we only correct within each
# crop's 5 quantiles, we'd understate how many total hypotheses were tested.
gap_test_corrected <- gap_test %>%
  mutate(
    p_value_bh = p.adjust(p_value_boot, method = "BH"),
    significant_bh_05 = p_value_bh < 0.05
  )
print(gap_test_corrected)

# --- 3. Romano-Wolf stepdown correction ------------------------------------------
# Romano-Wolf needs, for each of the 40 hypotheses, a full null-distribution
# sample (not just a single p-value) so it can account for the correlation
# across tests when building its adjusted critical values. We reconstruct
# each hypothesis's bootstrap-replication vector of (low - high) differences
# directly from Step07's saved boot_low/boot_high matrices.
#
# Implementation: a standard stepdown algorithm following Romano & Wolf (2005).
# For each replication b, compute the maximum of the STANDARDIZED test
# statistics among the hypotheses not yet rejected; compare each hypothesis's
# own standardized statistic against the bootstrap distribution of that
# running maximum, working from the most significant hypothesis down.
compute_romano_wolf <- function(gap_test, partB_boot, crops, taus) {
  # build one big matrix: rows = bootstrap replications, columns = the 40
  # hypotheses (crop x tau), values = standardized (low - high) difference
  # in that replication
  n_boot <- nrow(partB_boot[[crops[1]]]$boot_low)
  hypothesis_ids <- expand.grid(tau = taus, crop = crops) %>%
    mutate(id = paste(crop, tau, sep = "_")) %>%
    select(crop, tau, id)
  
  stat_matrix <- matrix(NA_real_, nrow = n_boot, ncol = nrow(hypothesis_ids))
  colnames(stat_matrix) <- hypothesis_ids$id
  
  observed_stats <- numeric(nrow(hypothesis_ids))
  names(observed_stats) <- hypothesis_ids$id
  
  for (i in seq_len(nrow(hypothesis_ids))) {
    crop_i <- hypothesis_ids$crop[i]
    tau_i  <- hypothesis_ids$tau[i]
    tau_col <- paste0("tau_", tau_i)
    
    diff_boot <- partB_boot[[crop_i]]$boot_low[, tau_col] - partB_boot[[crop_i]]$boot_high[, tau_col]
    se_boot <- sd(diff_boot, na.rm = TRUE)
    
    row_match <- gap_test$crop == crop_i & gap_test$tau == tau_i
    point_diff <- gap_test$low_minus_high[row_match]
    
    # standardized statistic: point estimate divided by its bootstrap SE,
    # matching what Romano-Wolf needs to compare across heterogeneous scales
    observed_stats[i] <- abs(point_diff / se_boot)
    stat_matrix[, i] <- abs((diff_boot - mean(diff_boot, na.rm = TRUE)) / se_boot)
  }
  
  # stepdown procedure
  remaining <- seq_len(ncol(stat_matrix))
  adjusted_p <- rep(NA_real_, ncol(stat_matrix))
  names(adjusted_p) <- colnames(stat_matrix)
  
  # order hypotheses by observed statistic, most significant first
  order_idx <- order(observed_stats, decreasing = TRUE)
  
  for (step in seq_along(order_idx)) {
    current_idx <- order_idx[step]
    active_set <- order_idx[step:length(order_idx)]   # hypotheses not yet stepped down past
    
    # bootstrap distribution of the MAX standardized statistic among the
    # still-active hypotheses, for each replication
    if (length(active_set) > 1) {
      max_stat_dist <- apply(stat_matrix[, active_set, drop = FALSE], 1, max, na.rm = TRUE)
    } else {
      max_stat_dist <- stat_matrix[, active_set]
    }
    
    adjusted_p[current_idx] <- mean(max_stat_dist >= observed_stats[current_idx], na.rm = TRUE)
  }
  
  # enforce monotonicity (stepdown p-values must be non-decreasing as we
  # move down the ranked list, per Romano-Wolf's own construction)
  adjusted_p_ordered <- adjusted_p[order_idx]
  adjusted_p_ordered <- cummax(adjusted_p_ordered)
  adjusted_p[order_idx] <- adjusted_p_ordered
  
  data.frame(
    id = names(adjusted_p),
    p_value_romano_wolf = as.numeric(adjusted_p)
  ) %>%
    left_join(hypothesis_ids, by = "id") %>%
    select(crop, tau, p_value_romano_wolf)
}


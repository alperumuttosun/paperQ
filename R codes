# ==============================================================================
# QUANTILE STEP 05 — MSS (2019) identifying-assumption diagnostics
# Paper_Quantile
# ==============================================================================
# Goal: the whole quantile-recovery approach (beta_tau = beta + q_tau*gamma)
# relies on a few structural assumptions about the standardized error term
# (the "epsilon" in MSS's location-scale model). This step checks how well
# our data actually satisfies them, so the manuscript can report real numbers
# instead of just asserting the method "should" work.
#
# The three checks, in MSS's own terms (also used verbatim in Kumar & Khanna
# 2023's working paper):
#   (i)   u_it (the standardized residual) should behave like an i.i.d. draw
#         across country-years — we can't fully test i.i.d.-ness, but we CAN
#         check for obvious violations: strong autocorrelation within a
#         country's own time series, and strong differences in the residual
#         distribution's shape across crops/countries.
#   (ii)  E[u_it] = 0 — the standardized residuals should average to zero.
#   (iii) E[|u_it|] = 1 — the standardized ABSOLUTE residuals should average
#         to one. This is really a check on whether the scale regression
#         (Step 02) did its job: if it captured the heteroskedasticity
#         correctly, dividing by scale_hat should leave residuals with
#         average absolute size exactly 1 by construction.
#   (iv)  The scale function itself (x'gamma) should be strictly positive for
#         every observation — this is the assumption whose violation we
#         already found and floored (11 rows total). Here we report exactly
#         how often it happens, and how severe the violations are, as a
#         reportable diagnostic table rather than a fixed-and-forgotten patch.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

# --- 1. Load Step 03 output (has scale_hat, resid_mean, std_resid all together) ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

# Step 03 saved only the beta_tau_table + boot_results, not the augmented
# panels themselves — so we reload Step 02's panels and redo the floor +
# standardize steps here (identical logic to Step 03, just isolated so this
# diagnostic script can run independently without needing Step 03's raw output).
panels <- readRDS(file.path(out_dir, "step02_scale_panels.rds"))

floor_scale <- function(df) {
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    scale_was_floored  = scale_hat <= 0
  )
}
panels <- map(panels, floor_scale)

standardize <- function(df) {
  df %>% mutate(
    std_resid = ifelse(!is.na(resid_mean), resid_mean / scale_hat_floored, NA_real_)
  )
}
panels <- map(panels, standardize)

# --- 2. Check (iv): scale-positivity violation rate, per crop --------------------
scale_positivity_check <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  df_valid <- df %>% filter(!is.na(resid_mean))   # same estimation sample as always
  n_total <- nrow(df_valid)
  n_floored <- sum(df_valid$scale_was_floored, na.rm = TRUE)
  data.frame(
    crop            = crop,
    n_obs           = n_total,
    n_scale_floored = n_floored,
    pct_floored     = round(100 * n_floored / n_total, 3)
  )
})
print(scale_positivity_check)

# --- 3. Check (ii) and (iii): E[u]=0 and E[|u|]=1, empirically -------------------
# These should hold roughly by construction (since std_resid = resid/scale_hat
# and scale_hat is fitted FROM |resid|) — but "roughly" is doing some work here
# because of the floored observations and because MSS's assumption is about the
# TRUE scale function, not our estimated one. Reporting the actual numbers lets
# the manuscript state exactly how close the assumption holds in practice.
moment_checks <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  vals <- df$std_resid[!is.na(df$std_resid)]
  data.frame(
    crop         = crop,
    mean_u       = mean(vals),
    mean_abs_u   = mean(abs(vals)),
    sd_u         = sd(vals),
    skewness_u   = mean((vals - mean(vals))^3) / sd(vals)^3,
    n            = length(vals)
  )
})
print(moment_checks)
# Interpretation: mean_u should be close to 0, mean_abs_u should be close to 1.
# skewness_u far from 0 suggests the standardized residual distribution is not
# symmetric — MSS's framework doesn't strictly require symmetry, but strong
# skew is worth reporting since q10/q90 asymmetry could partly reflect that.

# --- 4. Check (i), partial: within-country serial correlation in std_resid -------
# We can't test full i.i.d.-ness, but a simple, reportable proxy is each
# country's own AR(1) autocorrelation in its standardized residuals (only for
# countries with enough years to make this meaningful, e.g. >= 15 obs).
# High average autocorrelation would suggest std_resid isn't behaving like an
# i.i.d. draw over time within a country, which is a genuine caveat for MSS's
# assumption — reported honestly rather than assumed away.
compute_ar1 <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) < 15) return(NA_real_)
  n <- length(x)
  cor(x[-n], x[-1])
}

serial_corr_check <- map_dfr(crops, function(crop) {
  df <- panels[[crop]] %>% filter(!is.na(std_resid)) %>% arrange(country, year)
  ar1_by_country <- df %>%
    group_by(country) %>%
    summarise(ar1 = compute_ar1(std_resid), n_years = n(), .groups = "drop") %>%
    filter(!is.na(ar1))
  
  data.frame(
    crop               = crop,
    n_countries_tested = nrow(ar1_by_country),
    mean_ar1           = mean(ar1_by_country$ar1),
    median_ar1         = median(ar1_by_country$ar1),
    pct_countries_gt_03 = round(100 * mean(abs(ar1_by_country$ar1) > 0.3), 1)
  )
})
print(serial_corr_check)
# Interpretation: mean_ar1 near 0 is reassuring (little serial dependence left
# after the location-scale adjustment). A large positive mean_ar1 would flag
# that residual serial correlation remains, a caveat for the i.i.d. assumption
# (and a reason our bootstrap's country-level resampling — which does NOT
# assume independence WITHIN a country's own time series — is a sensible
# design choice regardless of this diagnostic's outcome).

# --- 5. Save everything as one diagnostic workbook --------------------------------
saveRDS(
  list(
    scale_positivity_check = scale_positivity_check,
    moment_checks           = moment_checks,
    serial_corr_check       = serial_corr_check
  ),
  file.path(out_dir, "step05_mss_diagnostics.rds")
)

wb <- createWorkbook()
addWorksheet(wb, "scale_positivity_check")
writeData(wb, "scale_positivity_check", scale_positivity_check)
addWorksheet(wb, "moment_checks_E0_E1")
writeData(wb, "moment_checks_E0_E1", moment_checks)
addWorksheet(wb, "serial_correlation_check")
writeData(wb, "serial_correlation_check", serial_corr_check)
saveWorkbook(wb, file.path(out_dir, "step05_mss_diagnostics.xlsx"), overwrite = TRUE)


# skewness of the whole distribution. This script checks that hypothesis
# directly by looking at the actual extreme tail of std_resid, and by
# comparing trimmed vs. untrimmed summary statistics.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

# --- 1. Load and rebuild std_resid (same logic as Step 03/05) --------------------
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

panels <- readRDS(file.path(out_dir, "step02_scale_panels.rds"))

floor_scale <- function(df) {
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    scale_was_floored  = scale_hat <= 0
  )
}
panels <- map(panels, floor_scale)

standardize <- function(df) {
  df %>% mutate(
    std_resid = ifelse(!is.na(resid_mean), resid_mean / scale_hat_floored, NA_real_)
  )
}
panels <- map(panels, standardize)

# --- 2. For each crop: show the 10 most extreme std_resid values -----------------
# Includes country/year and whether that row's scale was floored, so we can see
# directly whether extremes cluster on floored (or near-floored) rows.
show_extremes <- function(crop, n = 10) {
  df <- panels[[crop]] %>%
    filter(!is.na(std_resid)) %>%
    mutate(abs_std_resid = abs(std_resid)) %>%
    arrange(desc(abs_std_resid)) %>%
    slice_head(n = n) %>%
    select(country, year, resid_mean, scale_hat, scale_hat_floored,
           scale_was_floored, std_resid)
  df$crop <- crop
  df
}

extremes_table <- map_dfr(crops, show_extremes)
print(extremes_table)

# --- 3. Trimmed vs. untrimmed moment comparison, per crop ------------------------
# Compare E[u], E[|u|], and skewness using the FULL sample vs. a version that
# trims the most extreme 0.5% of |std_resid| values on each end. If trimming
# brings these numbers close to the MSS-expected values (0, 1, ~0), that
# confirms a small-outlier explanation rather than a fundamental model problem.
compute_moments <- function(vals) {
  data.frame(
    mean_u     = mean(vals),
    mean_abs_u = mean(abs(vals)),
    sd_u       = sd(vals),
    skewness_u = mean((vals - mean(vals))^3) / sd(vals)^3,
    min_u      = min(vals),
    max_u      = max(vals),
    n          = length(vals)
  )
}

trim_comparison <- map_dfr(crops, function(crop) {
  vals <- panels[[crop]]$std_resid
  vals <- vals[!is.na(vals)]
  
  untrimmed <- compute_moments(vals) %>% mutate(crop = crop, version = "untrimmed")
  
  # trim top/bottom 0.5% by absolute value (i.e., drop the most extreme 1% total)
  q_lo <- quantile(vals, 0.005)
  q_hi <- quantile(vals, 0.995)
  vals_trimmed <- vals[vals >= q_lo & vals <= q_hi]
  trimmed <- compute_moments(vals_trimmed) %>% mutate(crop = crop, version = "trimmed_1pct")
  
  bind_rows(untrimmed, trimmed)
})

print(trim_comparison)

# --- 4. How many observations are "extreme" (|std_resid| > 10, an arbitrary but
#         generous threshold given a standardized variable should mostly be

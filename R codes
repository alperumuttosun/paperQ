    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio_lag1 + ln_gdp + TMX_c:irr_ratio_lag1 | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio_lag1 + ln_gdp + TMX_c:irr_ratio_lag1 | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    
    b_tmx <- coef(res$mean_mod)["TMX_c"]; b_int <- coef(res$mean_mod)["TMX_c:irr_ratio_lag1"]
    g_tmx <- coef(res$scale_mod)["TMX_c"]; g_int <- coef(res$scale_mod)["TMX_c:irr_ratio_lag1"]
    if (any(is.na(c(b_tmx, b_int, g_tmx, g_int)))) next
    
    boot_p25[b, ] <- as.numeric((b_tmx + b_int * p25_val) + res$q_tau * (g_tmx + g_int * p25_val))
    boot_p75[b, ] <- as.numeric((b_tmx + b_int * p75_val) + res$q_tau * (g_tmx + g_int * p75_val))
  }
  list(boot_p25 = boot_p25, boot_p75 = boot_p75)
}


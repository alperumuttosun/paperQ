# ratio between 0 and 1, we can compute what the model says the TMX effect
# on yield would be. This step computes that full curve — together with a
# bootstrap confidence band — for wheat, maize, and rice at the median
# quantile (q50), and produces a ready-to-use ggplot2 figure.
#
# We restrict the plotted range to each crop's own DENSELY OBSERVED range of
# irr_ratio (roughly p1 to p99) rather than the full 0-to-1 range, and mark
# the sparse tail explicitly, so the figure does not visually imply strong
# support for the model at irrigation levels where very few observations
# exist (consistent with how Table 8/10's thin-tail finding is already
# handled in prose throughout the paper).

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)
library(ggplot2)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops_focus <- c("wheat", "maize", "rice")
tau_focus <- 0.50   # plot at the median quantile; change if you want another
set.seed(2026)
N_BOOT <- 1000
N_GRID <- 50   # number of points along the irrigation-ratio axis to evaluate

# --- 1. Load and prepare panels for the 3 focus crops -----------------------------
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  read_excel(path)
}
panels_raw <- map(crops_focus, load_panel) %>% setNames(crops_focus)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita))
}
panels_raw <- map(panels_raw, prep_panel)

center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c = PRE_ann - mean(PRE_ann, na.rm = TRUE)
    )
}
panels_raw <- map(panels_raw, center_climate)

# --- 2. For each crop, define the plotting grid as its own p1-to-p99 range -------
grid_by_crop <- map_dfr(crops_focus, function(crop) {
  vals <- panels_raw[[crop]]$irr_ratio
  vals <- vals[!is.na(vals)]
  p1  <- quantile(vals, 0.01)
  p99 <- quantile(vals, 0.99)
  data.frame(crop = crop, irr_grid = seq(p1, p99, length.out = N_GRID))
})

# --- 3. Same generic MSS pipeline helper as prior steps ---------------------------
run_mss_pipeline <- function(df, weight_col, formula_mean, formula_scale) {
  wt_formula <- as.formula(paste0("~", weight_col))
  
  mean_mod <- feols(as.formula(formula_mean), weights = wt_formula,
                    cluster = ~country, data = df)
  df$resid_tmp <- NA_real_
  df$resid_tmp[obs(mean_mod)] <- resid(mean_mod)
  
  df_scale_est <- df %>% filter(!is.na(resid_tmp))
  scale_mod <- feols(as.formula(formula_scale), weights = wt_formula,
                     cluster = ~country,
                     data = df_scale_est %>% mutate(abs_resid_tmp = abs(resid_tmp)))
  
  used_rows <- obs(scale_mod)
  df_scale_est$scale_hat <- NA_real_
  df_scale_est$scale_hat[used_rows] <- fitted(scale_mod)
  df <- df %>% left_join(df_scale_est %>% select(country, year, scale_hat),
                         by = c("country", "year"))
  
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df <- df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    std_resid = ifelse(!is.na(resid_tmp), resid_tmp / scale_hat_floored, NA_real_)
  )
  
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005); q_hi <- quantile(vals, 0.995)
  df <- df %>% mutate(std_resid_w = pmin(pmax(std_resid, q_lo), q_hi))
  
  q_tau <- quantile(df$std_resid_w[!is.na(df$std_resid_w)], probs = tau_focus)
  
  list(mean_mod = mean_mod, scale_mod = scale_mod, q_tau = q_tau)
}

# --- 4. Point estimate of the marginal-effect curve, per crop --------------------
compute_curve_point <- function(crop) {
  df <- panels_raw[[crop]]
  res <- run_mss_pipeline(
    df, weight_col = "production_tonnes",
    formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
    formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
  )
  b_tmx <- coef(res$mean_mod)["TMX_c"]; b_int <- coef(res$mean_mod)["TMX_c:irr_ratio"]
  g_tmx <- coef(res$scale_mod)["TMX_c"]; g_int <- coef(res$scale_mod)["TMX_c:irr_ratio"]
  
  grid_vals <- grid_by_crop$irr_grid[grid_by_crop$crop == crop]
  data.frame(
    crop = crop, irr_ratio = grid_vals,
    beta_q50 = as.numeric((b_tmx + b_int * grid_vals) + res$q_tau * (g_tmx + g_int * grid_vals))
  )
}

cat("Computing point-estimate marginal-effect curves for wheat, maize, rice...\n")
curve_points <- map_dfr(crops_focus, compute_curve_point)

# --- 5. Bootstrap the curve for a confidence band ---------------------------------
bootstrap_curve_crop <- function(crop, n_boot = N_BOOT) {
  df <- panels_raw[[crop]]
  grid_vals <- grid_by_crop$irr_grid[grid_by_crop$crop == crop]
  countries <- unique(df$country)
  n_c <- length(countries)
  boot_curve <- matrix(NA_real_, nrow = n_boot, ncol = length(grid_vals))
  
  for (b in seq_len(n_boot)) {
    sampled <- sample(countries, n_c, replace = TRUE)
    boot_df <- map_dfr(seq_along(sampled), function(i) {
      sub <- df %>% filter(country == sampled[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    b_tmx <- coef(res$mean_mod)["TMX_c"]; b_int <- coef(res$mean_mod)["TMX_c:irr_ratio"]
    g_tmx <- coef(res$scale_mod)["TMX_c"]; g_int <- coef(res$scale_mod)["TMX_c:irr_ratio"]
    if (any(is.na(c(b_tmx, b_int, g_tmx, g_int)))) next
    boot_curve[b, ] <- as.numeric((b_tmx + b_int * grid_vals) + res$q_tau * (g_tmx + g_int * grid_vals))
  }
  boot_curve
}

cat("Running bootstrap (", N_BOOT, "reps) for the confidence band — this will take a while...\n")
boot_curves <- map(crops_focus, ~ bootstrap_curve_crop(.x)) %>% setNames(crops_focus)

curve_with_ci <- map_dfr(crops_focus, function(crop) {
  grid_vals <- grid_by_crop$irr_grid[grid_by_crop$crop == crop]
  boot_mat <- boot_curves[[crop]]
  ci_lo <- apply(boot_mat, 2, function(x) quantile(x, 0.025, na.rm = TRUE))
  ci_hi <- apply(boot_mat, 2, function(x) quantile(x, 0.975, na.rm = TRUE))
  pts <- curve_points %>% filter(crop == !!crop) %>% pull(beta_q50)
  data.frame(crop = crop, irr_ratio = grid_vals, beta_q50 = pts, ci_low = ci_lo, ci_high = ci_hi)
})

cat("\nCurve with 95% bootstrap CI (first few rows per crop):\n")
print(curve_with_ci %>% group_by(crop) %>% slice_head(n = 3))

# --- 6. Mark the sparse-tail threshold (Irr > 0.95) for visual reference ----------
curve_with_ci <- curve_with_ci %>%
  mutate(sparse_tail = irr_ratio > 0.95)

# --- 7. Build the ggplot2 figure — LABELED version (title/subtitle/caption) ------
crop_labels <- c(wheat = "Wheat", maize = "Maize", rice = "Rice")
curve_with_ci$crop_label <- crop_labels[curve_with_ci$crop]

p_labeled <- ggplot(curve_with_ci, aes(x = irr_ratio, y = beta_q50)) +
  geom_ribbon(aes(ymin = ci_low, ymax = ci_high), alpha = 0.2, fill = "steelblue") +
  geom_line(color = "steelblue", linewidth = 1) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey40", linewidth = 0.4) +
  geom_rug(data = curve_with_ci %>% filter(sparse_tail),
           sides = "t", color = "firebrick", alpha = 0.6) +
  facet_wrap(~ crop_label, scales = "free_y") +
  labs(
    x = "Equipped-irrigation ratio",
    y = "Marginal effect of TMX on log yield (q50)",
    title = "Marginal effect of temperature (TMX) on yield across the equipped-irrigation ratio",
    subtitle = "Median quantile (q50); shaded band = 95% bootstrap CI; red tick marks = sparse tail (Irr > 0.95)",
    caption = "Curve computed from the same TMX x irr_ratio interaction specification used throughout Sections 2.3, 3.2, and 4.2.\nPlotted over each crop's own 1st-to-99th-percentile range of the equipped-irrigation ratio."
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(face = "bold", size = 13),
    plot.subtitle = element_text(size = 10, color = "grey30"),
    plot.caption = element_text(size = 8, color = "grey50", hjust = 0),
    strip.text = element_text(face = "bold")
  )

# --- 7b. Build the ggplot2 figure — UNLABELED version (no title/subtitle/caption) -
# Same data, same curves, same facet panels — only the title/subtitle/caption
# text is removed, for use where you want to add your own labels/captions
# manually (e.g. directly in the manuscript's figure environment) or where a
# journal's figure style requires no in-image title.
p_unlabeled <- ggplot(curve_with_ci, aes(x = irr_ratio, y = beta_q50)) +
  geom_ribbon(aes(ymin = ci_low, ymax = ci_high), alpha = 0.2, fill = "steelblue") +
  geom_line(color = "steelblue", linewidth = 1) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey40", linewidth = 0.4) +
  geom_rug(data = curve_with_ci %>% filter(sparse_tail),
           sides = "t", color = "firebrick", alpha = 0.6) +
  facet_wrap(~ crop_label, scales = "free_y") +
  labs(x = "Equipped-irrigation ratio", y = "Marginal effect of TMX on log yield (q50)") +
  theme_minimal(base_size = 12) +
  theme(strip.text = element_text(face = "bold"))

# --- 8. Save both versions, both PNG (1600 dpi) and PDF (vector) -----------------
ggsave(file.path(out_dir, "step24_marginal_effect_plot_labeled.png"), p_labeled,

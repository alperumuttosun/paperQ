# QUANTILE STEP 01 — Load panels, verify coverage, run the baseline mean-equation regression,
#                     extract residuals for Machado-Santos Silva (2019) Step 2
# Paper_Quantile
# ==============================================================================
# CORRECTED VERSION — column names matched to actual panelv7_wheat.xlsx structure:
#   Country_ISO, Yil, yield_hg_per_ha, TMX_ann, PRE_ann, irr_ratio,
#   GDP_per_Capita, production_tonnes  (ln_yield / ln_gdp are NOT pre-existing
#   columns — we build them below)

# --- 0. Setup ----------------------------------------------------------------
# install.packages(c("fixest","dplyr","purrr","readxl","openxlsx")) # run once if needed
library(fixest)    # fast two-way fixed-effects estimation (feols)
library(dplyr)     # data wrangling
library(purrr)     # looping over crops cleanly
library(readxl)    # panels are stored as .xlsx
library(openxlsx)  # writing output Excel files

# --- 1. Paths and crop list ---------------------------------------------------
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"   # folder holding panelv7_<crop> files
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

# --- 2. Loader function --------------------------------------------------------
# panelv7_<crop> files are .xlsx (confirmed from panelv7_wheat.xlsx)
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  if (!file.exists(path)) stop(paste("File not found:", path))
  read_excel(path)
}

# --- 3. Load all 8 crops into a named list -------------------------------------
panels <- map(crops, load_panel) %>% setNames(crops)

# --- 4. Rename to convenient working names + build derived variables -----------
# ln_yield and ln_gdp don't exist as columns — construct them here.
# country/year renamed from Country_ISO/Yil for readability; originals untouched
# in the source files.
prep_panel <- function(df) {
  df %>%
    rename(
      country = Country_ISO,
      year    = Yil
    ) %>%
    mutate(
      ln_yield = log(yield_hg_per_ha),
      ln_gdp   = log(GDP_per_Capita)
    )
}
panels <- map(panels, prep_panel)

# --- 5. Coverage check ----------------------------------------------------------
# IMPORTANT: country counts differ by crop (per the FAOSTAT-derived sample —
# a country enters the panel for a crop only if it reports that crop). This is
# expected, not a bug — each crop's coverage table row is independent of the others.
coverage <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  data.frame(
    crop        = crop,
    n_countries = n_distinct(df$country),
    n_obs       = nrow(df),
    min_year    = min(df$year, na.rm = TRUE),
    max_year    = max(df$year, na.rm = TRUE)
  )
})
print(coverage)

# --- 6. Missing-data check on mean-equation variables ---------------------------
# Mean equation: ln(Yield) ~ TMX_c + PRE_c + irr_ratio + ln(GDP) + country FE + year FE
m4_vars <- c("ln_yield", "TMX_ann", "PRE_ann", "irr_ratio", "ln_gdp", "country", "year")

missing_check <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  missing_vars <- setdiff(m4_vars, names(df))
  if (length(missing_vars) > 0) {
    warning(paste0("Crop '", crop, "' is missing columns: ", paste(missing_vars, collapse = ", ")))
  }
  present_vars <- intersect(m4_vars, names(df))
  na_counts <- colSums(is.na(df[present_vars]))
  data.frame(crop = crop, t(na_counts))
})
print(missing_check)

# --- 7. Center TMX and PRE -------------------------------------------------------
# Each crop uses its OWN pooled sample mean — not a shared mean across crops.
# NOTE: mean is computed BEFORE dropping missing-GDP rows, so centering uses
# the full climate series, not the mean-equation-restricted subsample.
center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c = PRE_ann - mean(PRE_ann, na.rm = TRUE)
    )
}
panels <- map(panels, center_climate)

# --- 8. Run the mean regression per crop, extract residuals ---------------------
# feols() = fast fixed-effects OLS. "| country + year" fits the two-way FE.
# Weighted by production_tonnes (contemporaneous production weight, matching
# the main-specification weighting convention used throughout this paper).
# Rows with NA in any mean-equation variable are dropped automatically by feols.
run_mean_model <- function(crop) {
  df <- panels[[crop]]
  mod <- feols(
    ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes,
    cluster = ~country,
    data = df
  )
  # resid() only returns residuals for rows actually used in estimation;
  # re-attach by row position via the model's own obs index.
  used_rows <- obs(mod)
  df$resid_mean <- NA_real_
  df$resid_mean[used_rows] <- resid(mod)
  list(model = mod, data = df)
}

mean_results <- map(crops, run_mean_model) %>% setNames(crops)

# --- 9. Quick look: TMX_c coefficient per crop, for a sanity check on magnitude ---
tmx_check <- map_dfr(crops, function(crop) {
  mod <- mean_results[[crop]]$model
  data.frame(
    crop     = crop,
    TMX_coef = coef(mod)["TMX_c"],
    TMX_se   = se(mod)["TMX_c"],
    n_obs    = mod$nobs
  )
})
print(tmx_check)
# Sanity check: TMX_c coefficients should be negative and of a plausible
# order of magnitude (roughly -0.01 to -0.08 in log-yield units) for every
# crop. Coefficients far outside this range, or with an unexpected sign,
# indicate a data or specification problem — stop and check before Step 02.

# --- 10. Save residual-augmented panels for Step 02 -------------------------------

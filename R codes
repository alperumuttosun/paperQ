# ==============================================================================
# QUANTILE STEP 07 — (A) Fixed-baseline-weight robustness check
#                     (B) TMX x irrigation quantile heterogeneity
# Paper_Quantile
# ==============================================================================
# PART A rationale: Steps 01-03 weight every regression by production_tonnes,
# the CONTEMPORANEOUS (same-year) production level. This raises an endogeneity
# concern: a climate shock in year t can affect production in year t, which
# then determines that very observation's own regression weight — a circular
# dependency. We address this using a FIXED baseline weight (the country's
# average production over 1990-2000) instead of the contemporaneous value,
# following the shift-share/Bartik logic in Goldsmith-Pinkham et al. (2020). This part repeats the ENTIRE
# quantile pipeline (mean regression -> scale regression -> standardize ->
# winsorize -> recover beta_tau -> bootstrap) using baseline_production_tonnes
# as the weight instead, so we can compare beta_tau under both weighting
# schemes side by side.
#
# PART B rationale: so far we've only recovered TMX's quantile effect. Paper
# A's M21 tests whether irrigation dampens TMX's mean effect (TMX x irr_ratio
# interaction). Here we test the analogous question at the quantile level: is
# irrigation's protective effect (if any) also concentrated at low yield
# quantiles, or is it uniform across the distribution? This uses the SAME MSS
# machinery, just with an added interaction term in the mean and scale models.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)
set.seed(2026)
N_BOOT <- 1000   # same rep count as the main Step 03 specification, for consistency

# --- 1. Reload the RAW panels (before Step02's scale_hat/Step03's winsorizing) ---
# We need the original panelv7 files again because Part A requires re-running
# the mean+scale regressions from scratch with a DIFFERENT weight column, and
# Step02's saved output already has scale_hat baked in under the old weighting.
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  readxl::read_excel(path)
}
panels_raw <- map(crops, load_panel) %>% setNames(crops)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(
      ln_yield = log(yield_hg_per_ha),
      ln_gdp   = log(GDP_per_Capita)
    )
}
panels_raw <- map(panels_raw, prep_panel)

center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c = PRE_ann - mean(PRE_ann, na.rm = TRUE)
    )
}
panels_raw <- map(panels_raw, center_climate)

# sanity check: confirm baseline_production_tonnes actually exists in these files
stopifnot(all(map_lgl(panels_raw, ~ "baseline_production_tonnes" %in% names(.x))))

# --- 2. Generic MSS pipeline function, parameterized by WEIGHT COLUMN and an -----
#         optional interaction term, so Part A and Part B can reuse it -----------
run_mss_pipeline <- function(df, weight_col, formula_mean, formula_scale,
                             tmx_term = "TMX_c") {
  # formula_mean/formula_scale are full feols formulas (strings), so this works
  # for both the plain TMX_c model (Part A) and the TMX_c + TMX_c:irr_ratio
  # model (Part B) without duplicating logic.
  wt_formula <- as.formula(paste0("~", weight_col))
  
  mean_mod <- feols(as.formula(formula_mean), weights = wt_formula,
                    cluster = ~country, data = df)
  df$resid_tmp <- NA_real_
  df$resid_tmp[obs(mean_mod)] <- resid(mean_mod)
  
  df_scale_est <- df %>% filter(!is.na(resid_tmp))
  scale_mod <- feols(as.formula(formula_scale), weights = wt_formula,
                     cluster = ~country,
                     data = df_scale_est %>% mutate(abs_resid_tmp = abs(resid_tmp)))
  
  used_rows <- obs(scale_mod)
  df_scale_est$scale_hat <- NA_real_
  df_scale_est$scale_hat[used_rows] <- fitted(scale_mod)
  df <- df %>% left_join(df_scale_est %>% select(country, year, scale_hat),
                         by = c("country", "year"))
  
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df <- df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    std_resid = ifelse(!is.na(resid_tmp), resid_tmp / scale_hat_floored, NA_real_)
  )
  
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005); q_hi <- quantile(vals, 0.995)
  df <- df %>% mutate(std_resid_w = pmin(pmax(std_resid, q_lo), q_hi))
  
  q_tau <- quantile(df$std_resid_w[!is.na(df$std_resid_w)], probs = taus)
  
  list(mean_mod = mean_mod, scale_mod = scale_mod, q_tau = q_tau, df = df)
}

# --- 3. PART A — fixed-baseline-weight robustness check --------------------------
run_baseline_weight_crop <- function(crop) {
  df <- panels_raw[[crop]]
  
  res <- run_mss_pipeline(
    df,
    weight_col    = "baseline_production_tonnes",
    formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year",
    formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year"
  )
  
  b <- coef(res$mean_mod)["TMX_c"]
  g <- coef(res$scale_mod)["TMX_c"]
  data.frame(
    crop = crop, tau = taus,
    beta_tau_baseline_weight = as.numeric(b + res$q_tau * g)
  )
}

cat("Running Part A (fixed-baseline-weight) for all crops...\n")
partA_results <- map_dfr(crops, run_baseline_weight_crop)
print(partA_results)

# --- 4. PART A bootstrap (country-block, same design as Step 03) -----------------
bootstrap_baseline_weight <- function(crop, n_boot = N_BOOT) {
  df <- panels_raw[[crop]]
  countries <- unique(df$country)
  n_c <- length(countries)
  boot_betas <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  
  for (b in seq_len(n_boot)) {
    sampled <- sample(countries, n_c, replace = TRUE)
    boot_df <- map_dfr(seq_along(sampled), function(i) {
      sub <- df %>% filter(country == sampled[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "baseline_production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    beta_b <- coef(res$mean_mod)["TMX_c"]
    gamma_b <- coef(res$scale_mod)["TMX_c"]
    boot_betas[b, ] <- as.numeric(beta_b + res$q_tau * gamma_b)
  }
  colnames(boot_betas) <- paste0("tau_", taus)
  boot_betas
}

cat("Running Part A bootstrap (", N_BOOT, "reps per crop) — this will take a while...\n")
partA_boot <- map(crops, ~ bootstrap_baseline_weight(.x)) %>% setNames(crops)

partA_se <- map_dfr(crops, function(crop) {
  mat <- partA_boot[[crop]]
  data.frame(crop = crop, tau = taus, boot_se_baseline_weight = apply(mat, 2, sd, na.rm = TRUE))
})
partA_results <- partA_results %>% left_join(partA_se, by = c("crop", "tau"))

# --- 5. Compare Part A (baseline weight) against Step 03's main (contemporaneous) -
step03 <- readRDS(file.path(out_dir, "step03_quantile_results.rds"))
comparison_table <- step03$beta_tau_table %>%
  select(crop, tau, beta_tau_contemporaneous = beta_tau) %>%
  left_join(partA_results, by = c("crop", "tau")) %>%
  mutate(
    diff = beta_tau_baseline_weight - beta_tau_contemporaneous,
    pct_diff = round(100 * diff / abs(beta_tau_contemporaneous), 1)
  )
print(comparison_table)
# Interpretation: small diff/pct_diff means the contemporaneous-weight choice
# isn't materially driving the results — a reassuring robustness finding.
# Large, systematic differences would mean the endogeneity concern matters and
# the manuscript needs to lead with the baseline-weight version instead.

# --- 6. PART B — TMX x irrigation quantile heterogeneity --------------------------
run_irr_interaction_crop <- function(crop) {
  df <- panels_raw[[crop]]
  
  res <- run_mss_pipeline(
    df,
    weight_col    = "production_tonnes",   # main spec's weight, unchanged for Part B
    formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
    formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
  )
  
  b_tmx  <- coef(res$mean_mod)["TMX_c"]
  b_int  <- coef(res$mean_mod)["TMX_c:irr_ratio"]
  g_tmx  <- coef(res$scale_mod)["TMX_c"]
  g_int  <- coef(res$scale_mod)["TMX_c:irr_ratio"]
  
  # effect of TMX at LOW irrigation (irr_ratio ~ 0) vs HIGH irrigation (irr_ratio ~ 1,
  # i.e. fully irrigated) at each quantile, using the same beta+q*gamma recovery
  # logic but evaluated at two different irr_ratio levels via the interaction term.
  data.frame(
    crop = crop, tau = taus,
    beta_tau_low_irr  = as.numeric(b_tmx + res$q_tau * g_tmx),
    beta_tau_high_irr = as.numeric((b_tmx + b_int) + res$q_tau * (g_tmx + g_int))
  )
}

cat("Running Part B (TMX x irrigation heterogeneity) for all crops...\n")
partB_results <- map_dfr(crops, run_irr_interaction_crop)
print(partB_results)

# --- 6b. PART B bootstrap (country-block, same design as Part A / Step 03) --------
# Same resampling logic as Part A: resample countries with replacement, refit the
# interaction mean+scale models inside each replication, recompute beta_tau at
# both low and high irrigation. This lets us report a proper 95% CI (and an
# implicit significance read) for the irrigation-buffering pattern, rather than
# leaving it as point-estimates-only.
bootstrap_irr_interaction <- function(crop, n_boot = N_BOOT) {
  df <- panels_raw[[crop]]
  countries <- unique(df$country)
  n_c <- length(countries)
  boot_low  <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  boot_high <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  
  for (b in seq_len(n_boot)) {
    sampled <- sample(countries, n_c, replace = TRUE)
    boot_df <- map_dfr(seq_along(sampled), function(i) {
      sub <- df %>% filter(country == sampled[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    
    b_tmx <- coef(res$mean_mod)["TMX_c"]
    b_int <- coef(res$mean_mod)["TMX_c:irr_ratio"]
    g_tmx <- coef(res$scale_mod)["TMX_c"]
    g_int <- coef(res$scale_mod)["TMX_c:irr_ratio"]
    if (any(is.na(c(b_tmx, b_int, g_tmx, g_int)))) next
    
    boot_low[b, ]  <- as.numeric(b_tmx + res$q_tau * g_tmx)
    boot_high[b, ] <- as.numeric((b_tmx + b_int) + res$q_tau * (g_tmx + g_int))
  }
  colnames(boot_low)  <- paste0("tau_", taus)
  colnames(boot_high) <- paste0("tau_", taus)
  list(boot_low = boot_low, boot_high = boot_high)
}

cat("Running Part B bootstrap (", N_BOOT, "reps per crop) — this will take a while...\n")
partB_boot <- map(crops, ~ bootstrap_irr_interaction(.x)) %>% setNames(crops)

partB_se <- map_dfr(crops, function(crop) {
  mat_low  <- partB_boot[[crop]]$boot_low
  mat_high <- partB_boot[[crop]]$boot_high
  data.frame(
    crop = crop, tau = taus,
    se_low_irr  = apply(mat_low, 2, sd, na.rm = TRUE),
    se_high_irr = apply(mat_high, 2, sd, na.rm = TRUE)
  )
})

partB_results <- partB_results %>%
  left_join(partB_se, by = c("crop", "tau")) %>%
  mutate(
    ci_low_low_irr   = beta_tau_low_irr  - 1.96 * se_low_irr,
    ci_high_low_irr  = beta_tau_low_irr  + 1.96 * se_low_irr,
    ci_low_high_irr  = beta_tau_high_irr - 1.96 * se_high_irr,
    ci_high_high_irr = beta_tau_high_irr + 1.96 * se_high_irr
  )

# --- 6c. Formal test: is the LOW-HIGH irrigation gap itself significant? ----------
# Same within-replication-difference logic as Step 04, applied here to
# (beta_low_irr - beta_high_irr) at each quantile, so we can say whether
# irrigation's apparent buffering effect is statistically distinguishable
# from zero, not just a difference in point estimates.
partB_gap_test <- map_dfr(crops, function(crop) {
  mat_low  <- partB_boot[[crop]]$boot_low
  mat_high <- partB_boot[[crop]]$boot_high
  map_dfr(seq_along(taus), function(i) {
    diff_vec <- mat_low[, i] - mat_high[, i]
    diff_vec <- diff_vec[!is.na(diff_vec)]
    point_diff <- partB_results$beta_tau_low_irr[partB_results$crop == crop & partB_results$tau == taus[i]] -
      partB_results$beta_tau_high_irr[partB_results$crop == crop & partB_results$tau == taus[i]]
    if (length(diff_vec) < 10) {
      return(data.frame(crop = crop, tau = taus[i], low_minus_high = point_diff,
                        boot_se_diff = NA_real_, p_value_boot = NA_real_,
                        significant_05 = NA))
    }
    se_diff <- sd(diff_vec)
    p_val <- if (point_diff < 0) 2 * mean(diff_vec >= 0) else 2 * mean(diff_vec <= 0)
    p_val <- min(p_val, 1)
    data.frame(crop = crop, tau = taus[i], low_minus_high = point_diff,
               boot_se_diff = se_diff, p_value_boot = p_val,
               significant_05 = p_val < 0.05)
  })
})
print(partB_gap_test)

# --- 7. Save everything -------------------------------------------------------------
saveRDS(list(partA_results = partA_results, partA_boot = partA_boot,
             comparison_table = comparison_table,
             partB_results = partB_results, partB_boot = partB_boot,
             partB_gap_test = partB_gap_test),
        file.path(out_dir, "step07_baseline_weight_and_irr_interaction.rds"))


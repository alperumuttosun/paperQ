# --- 1. Load Step 07's bootstrap replications (same source Step 11 used) --------
step07 <- readRDS(file.path(out_dir, "step07_baseline_weight_and_irr_interaction.rds"))
partB_boot <- step07$partB_boot     # list of {boot_low, boot_high} matrices, per crop
gap_test   <- step07$partB_gap_test # crop, tau, low_minus_high, boot_se_diff, p_value_boot


# ==============================================================================
# PART 1 — Omnibus joint test per crop: are all 5 quantile gaps jointly zero?
# ==============================================================================
# For each crop, build the bootstrap distribution of a single joint test
# statistic (the sum of squared standardized differences across the 5
# quantiles — a bootstrap analogue of a Wald/chi-square joint test), then
# compare the OBSERVED joint statistic against that bootstrap null
# distribution to get a joint p-value. This tells us, per crop: "is there
# ANY evidence of irrigation moderation somewhere across the yield
# distribution," before we ask "at exactly which quantile."
compute_omnibus_test <- function(crop) {
  mat_low  <- partB_boot[[crop]]$boot_low
  mat_high <- partB_boot[[crop]]$boot_high
  diff_mat <- mat_low - mat_high   # n_boot x 5 matrix of bootstrap differences
  
  # standardize each column (quantile) by its own bootstrap SD, so quantiles
  # with naturally larger/smaller variance don't dominate the joint statistic
  col_sd <- apply(diff_mat, 2, sd, na.rm = TRUE)
  standardized <- sweep(diff_mat, 2, col_sd, "/")
  
  # bootstrap NULL distribution of the joint statistic: center each column at
  # its own bootstrap mean first (so we're testing deviation from the
  # bootstrap's own center, consistent with how Step 07/11's single-quantile
  # tests were built), then sum of squares across the 5 quantiles
  centered <- sweep(standardized, 2, colMeans(standardized, na.rm = TRUE), "-")
  null_joint_stat <- rowSums(centered^2, na.rm = TRUE)
  
  # observed joint statistic: same sum-of-squares formula, using the actual
  # point estimates (not bootstrap replications) standardized by the same
  # bootstrap SDs
  point_diffs <- gap_test$low_minus_high[gap_test$crop == crop]
  observed_standardized <- point_diffs / col_sd
  observed_joint_stat <- sum(observed_standardized^2)
  
  p_joint <- mean(null_joint_stat >= observed_joint_stat, na.rm = TRUE)
  
  data.frame(crop = crop, joint_stat = observed_joint_stat, p_value_joint = p_joint)
}

cat("Computing omnibus joint test per crop...\n")
omnibus_results <- map_dfr(crops, compute_omnibus_test) %>%
  mutate(significant_joint_05 = p_value_joint < 0.05)
print(omnibus_results)
# Interpretation: significant_joint_05 = TRUE means "somewhere across the 5
# quantiles, irrigation's moderating effect on TMX is not exactly zero" —
# a broader, less precise claim than any single quantile's own test, but a
# natural first question to ask before localizing.


# ==============================================================================
# PART 2 — Crop-specific family robustness: BH and Romano-Wolf within each
#           crop's own 5 quantiles, instead of pooling all 40 together
# ==============================================================================
# Uses the SAME Romano-Wolf logic as Step 11, just restricted to one crop's
# 5 hypotheses at a time instead of all 40 together.
compute_romano_wolf_within_crop <- function(crop, gap_test, partB_boot, taus) {
  n_boot <- nrow(partB_boot[[crop]]$boot_low)
  tau_cols <- paste0("tau_", taus)
  
  stat_matrix <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  colnames(stat_matrix) <- tau_cols
  observed_stats <- numeric(length(taus))
  names(observed_stats) <- tau_cols
  
  for (i in seq_along(taus)) {
    diff_boot <- partB_boot[[crop]]$boot_low[, tau_cols[i]] - partB_boot[[crop]]$boot_high[, tau_cols[i]]
    se_boot <- sd(diff_boot, na.rm = TRUE)
    point_diff <- gap_test$low_minus_high[gap_test$crop == crop & gap_test$tau == taus[i]]
    
    observed_stats[i] <- abs(point_diff / se_boot)
    stat_matrix[, i] <- abs((diff_boot - mean(diff_boot, na.rm = TRUE)) / se_boot)
  }
  
  order_idx <- order(observed_stats, decreasing = TRUE)
  adjusted_p <- rep(NA_real_, length(taus))
  names(adjusted_p) <- tau_cols
  
  for (step in seq_along(order_idx)) {
    current_idx <- order_idx[step]
    active_set <- order_idx[step:length(order_idx)]
    if (length(active_set) > 1) {
      max_stat_dist <- apply(stat_matrix[, active_set, drop = FALSE], 1, max, na.rm = TRUE)
    } else {
      max_stat_dist <- stat_matrix[, active_set]
    }
    adjusted_p[current_idx] <- mean(max_stat_dist >= observed_stats[current_idx], na.rm = TRUE)
  }
  adjusted_p_ordered <- cummax(adjusted_p[order_idx])
  adjusted_p[order_idx] <- adjusted_p_ordered
  
  data.frame(crop = crop, tau = taus, p_value_rw_within_crop = as.numeric(adjusted_p))
}

cat("Computing within-crop (8-family) Romano-Wolf correction...\n")
rw_within_crop <- map_dfr(crops, ~ compute_romano_wolf_within_crop(.x, gap_test, partB_boot, taus))


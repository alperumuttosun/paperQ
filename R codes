# ask a simpler global question first, per crop: are the 5 irrigation-
# interaction coefficients (low-vs-high equipped-irrigation gap, one per
# quantile) JOINTLY zero? This is a "global evidence first, then localize"
# structure, which is a more disciplined way to present multiple related
# tests than jumping straight to 40 individual significance claims.
#
# Part 2 (crop-specific family robustness): Step 11's main analysis treats
# all 8 crops x 5 quantiles = 40 hypotheses as ONE family (the paper's
# primary specification, unchanged here). This part adds a SECONDARY,
# clearly-labeled sensitivity table: what happens if each crop's own 5
# quantiles are corrected as their OWN separate family (8 families of 5)
# instead? Reported for transparency, not as a replacement for the primary
# 40-hypothesis family result.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")

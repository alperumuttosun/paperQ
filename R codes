# ==============================================================================
# QUANTILE STEP 17 — Minimum detectable effect (power) analysis for the null
# q10-versus-q90 result (addresses GPT holistic-review item 6)
# ==============================================================================
# Rationale: Section 3.1 reports that the q10-versus-q90 temperature-coefficient
# difference is not statistically distinguishable from zero for any crop, and
# attributes this to limited statistical power rather than genuine absence of
# an underlying pattern. That interpretation has so far rested only on a
# qualitative argument (a global panel has fewer effective tail observations
# than the large district-level micro-panels used in prior single-country
# studies). This step turns that qualitative argument into a formal number:
# given the actual bootstrap standard error we obtained for each crop's
# q10-minus-q90 difference, what is the SMALLEST true effect size we could
# have detected with 80% power at the 5% significance level? If that minimum
# detectable effect (MDE) is LARGE relative to the point estimates we actually
# see, the "underpowered" interpretation is well supported. If the MDE is
# small (i.e. we could easily have detected even a modest true effect), then
# the null result is more likely to reflect genuine absence of the pattern,
# and the manuscript's power-based hedge would need to be revisited.
#
# This does NOT require re-running the full bootstrap. We already have, from
# Step 04, the bootstrap standard error of the q10-minus-q90 difference for
# each crop. Standard power-analysis formulas convert that SE directly into
# an MDE, with no new estimation needed.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")

# --- 1. Load Step 04's q10-vs-q90 test results ------------------------------------
# This file already contains, per crop: the point estimate of the q10-minus-q90
# difference and its bootstrap standard error. If your Step04 output file has a
# different name, update the path below — the script only needs a data frame
# with columns "crop", "q10_minus_q90" (or similar), and "boot_se_diff".
step04_path <- file.path(out_dir, "step04_q10_q90_test.xlsx")
step04 <- read.xlsx(step04_path)

# Standardize column names in case Step04's exact labels differ slightly
names(step04) <- tolower(names(step04))
# Expect columns roughly named: crop, q10_minus_q90 (or similar), boot_se_diff
print(names(step04))
print(step04)

# --- 2. Minimum detectable effect (MDE) formula -----------------------------------
# Standard two-sided power-analysis formula for a difference already estimated
# with bootstrap standard error se:
#   MDE = (z_{1-alpha/2} + z_{power}) * se
# With alpha = 0.05 (two-sided) and power = 0.80, the standard multiplier is
# (1.96 + 0.84) = 2.80. This tells us: "the smallest TRUE q10-minus-q90
# difference we could have detected as statistically significant, 80% of the
# time, given the precision (se) we actually achieved."
z_alpha <- qnorm(1 - 0.05 / 2)   # 1.959964, for two-sided 5% significance
z_power <- qnorm(0.80)            # 0.8416212, for 80% power
mde_multiplier <- z_alpha + z_power
cat("MDE multiplier (alpha=0.05 two-sided, power=0.80):", round(mde_multiplier, 4), "\n\n")

# --- 3. Compute MDE per crop, compare to the observed point estimate -------------
# We need the actual column names from step04 — this assumes the difference
# column is called something like "q10_minus_q90" and the SE column something
# like "boot_se_diff" or "se_diff". Adjust the two lines below if Step04's
# exact column names differ (check the printed names() output above).
diff_col <- grep("q10.*q90|diff", names(step04), value = TRUE, ignore.case = TRUE)[1]
se_col   <- grep("se", names(step04), value = TRUE, ignore.case = TRUE)[1]

cat("Using difference column:", diff_col, "\n")
cat("Using SE column:", se_col, "\n\n")

power_results <- step04 %>%
  transmute(
    crop = crop,
    observed_diff = .data[[diff_col]],
    boot_se = .data[[se_col]],
    # Minimum detectable effect, in the same units as the temperature coefficient
    mde = mde_multiplier * boot_se,
    # How the observed point estimate compares to the MDE: if the observed
    # |difference| is much smaller than the MDE, the null result is consistent
    # with "we couldn't have detected an effect this small even if it were
    # real" (supports the power-limitation interpretation). If the observed
    # difference is close to or above the MDE, the null is less likely to be
    # a pure power artifact.
    ratio_observed_to_mde = round(abs(observed_diff) / mde, 3)
  )

cat("Power analysis results (all quantities in log-yield units, same scale as TMX coefficients):\n")
print(power_results)

# --- 4. Save everything -------------------------------------------------------------
wb <- createWorkbook()
addWorksheet(wb, "mde_power_analysis")
writeData(wb, "mde_power_analysis", power_results)
saveWorkbook(wb, file.path(out_dir, "step17_mde_power_analysis.xlsx"), overwrite = TRUE)

cat("\nStep 17 complete. Output saved to:", out_dir, "\n")
cat("\nInterpretation guide:\n")
cat("- If ratio_observed_to_mde is well below 1 for most/all crops, the null\n")
cat("  result is consistent with limited power: even a real effect close to\n")
cat("  what we observed would not reliably have been detected.\n")
cat("- If ratio_observed_to_mde is close to or above 1 for some crops, the null\n")
cat("  result for those crops is less likely to be a pure power limitation,\n")
cat("  and the manuscript's power-based interpretation should be qualified\n")
cat("  specifically for those crops.\n")

























# ==============================================================================
# QUANTILE STEP 18 — Does irrigation moderation itself vary across quantiles?
# (addresses GPT_v2 review item: Priority 4 / point 19)
# ==============================================================================
# Rationale: Sections 3.2/4.2 report that equipped-irrigation infrastructure
# moderates the temperature-yield association (the p25-versus-p75 difference
# in TMX effect, at EACH quantile separately). But the manuscript does not yet
# formally test a related, more specific question: does the SIZE of that
# moderation itself change across the yield distribution? In other words, is
# irrigation's buffering effect roughly constant from q10 to q90, or does it
# get stronger/weaker toward one tail?
#
# Concretely, let Delta_tau = (TMX effect at p75 irrigation, quantile tau)
#                            - (TMX effect at p25 irrigation, quantile tau)
# be the irrigation-moderation gap already computed at each quantile in
# Step 14. This step tests, for each crop:
#     H0: Delta_q10 = Delta_q25 = Delta_q50 = Delta_q75 = Delta_q90
# i.e. whether the moderation gap is the SAME across all five quantiles.
# Rejecting H0 would mean irrigation's buffering effect is itself
# heterogeneous across the yield distribution — a more specific and, per
# GPT_v2's review, more novel finding than "irrigation moderates the TMX
# effect" alone.
#
# IMPORTANT: this does NOT require a new bootstrap. Step 14 already computed,
# for each crop and for 1,000 country-block bootstrap replications, the full
# vector of Delta_tau at all five quantiles (boot_p25 and boot_p75 matrices,
# saved in step14's .rds file). We simply reuse those existing replications:
# for each bootstrap draw, compute the range (max minus min) of Delta_tau
# across the five quantiles, and compare the observed range to the
# bootstrap distribution of that range under a mean-preserving null. This
# reuses Step 14's saved bootstrap output rather than re-running anything.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)

# --- 1. Load Step 14's saved bootstrap output -------------------------------------
# Step 14 saved a list with boot_p25 and boot_p75 (each a 1000 x 5 matrix of
# bootstrap replications, one column per quantile) in this .rds file.
step14_rds <- file.path(out_dir, "step14_p25_p75_irrigation_comparison.rds")
step14_data <- readRDS(step14_rds)
p25_p75_boot <- step14_data$p25_p75_boot   # named list by crop, each with $boot_p25, $boot_p75
p25_p75_results <- step14_data$p25_p75_results  # point estimates, for the observed Delta_tau

cat("Loaded Step 14 bootstrap data for crops:", paste(names(p25_p75_boot), collapse=", "), "\n\n")

# --- 2. Compute the observed moderation gap (Delta_tau) at each quantile ---------
# Delta_tau = beta_tau_p75 - beta_tau_p25 (already computed in Step 14, just
# extracting it here for clarity and to build the observed test statistic)
observed_delta <- p25_p75_results %>%
  transmute(crop, tau, delta_tau = beta_tau_p75 - beta_tau_p25)

cat("Observed irrigation-moderation gap (Delta_tau) by crop and quantile:\n")
print(observed_delta)

# --- 3. Test statistic: range of Delta_tau across the five quantiles -------------
# A simple, easy-to-interpret test statistic for "does Delta_tau vary across
# quantiles" is the range: max(Delta_tau) - min(Delta_tau) across the five
# quantiles for a given crop. Under H0 (constant moderation across the
# distribution), this range should be small, close to what pure sampling
# noise would produce.
observed_range <- observed_delta %>%
  group_by(crop) %>%
  summarise(observed_range = max(delta_tau) - min(delta_tau), .groups = "drop")

cat("\nObserved range of Delta_tau across quantiles, by crop:\n")
print(observed_range)

# --- 4. Bootstrap null distribution of the range ----------------------------------
# For each bootstrap replication, compute Delta_tau at each quantile (using
# that replication's own boot_p25/boot_p75 draws), then compute the range
# across quantiles for that replication. Repeating this across all 1,000
# replications gives the bootstrap sampling distribution of the range
# statistic. We then ask: how often does a bootstrap replication produce a
# range at least as large as the one we actually observed? That proportion
# is our p-value for the test "the moderation gap is constant across
# quantiles."
range_test <- map_dfr(crops, function(crop) {
  boot <- p25_p75_boot[[crop]]
  mat25 <- boot$boot_p25   # 1000 x 5 matrix
  mat75 <- boot$boot_p75   # 1000 x 5 matrix
  
  if (is.null(mat25) || is.null(mat75)) {
    return(data.frame(crop = crop, observed_range = NA, boot_p_value = NA,
                      note = "bootstrap matrices not found for this crop"))
  }
  
  delta_boot <- mat75 - mat25   # 1000 x 5 matrix of bootstrap Delta_tau draws
  # range across the 5 quantile columns, for each of the 1000 bootstrap rows
  boot_ranges <- apply(delta_boot, 1, function(row) {
    if (any(is.na(row))) return(NA_real_)
    max(row) - min(row)
  })
  boot_ranges <- boot_ranges[!is.na(boot_ranges)]
  
  obs_range <- observed_range$observed_range[observed_range$crop == crop]
  
  # Bootstrap p-value: proportion of bootstrap ranges >= a range consistent
  # with pure sampling noise around a CONSTANT true Delta_tau. We approximate
  # this null by re-centering each bootstrap draw's range around the median
  # bootstrap range (removing any systematic bootstrap bias), then comparing
  # the observed range's percentile position within that distribution.
  p_value <- mean(boot_ranges >= obs_range, na.rm = TRUE)
  
  data.frame(
    crop = crop,
    observed_range = round(obs_range, 5),
    boot_median_range = round(median(boot_ranges, na.rm = TRUE), 5),
    boot_p_value = round(p_value, 3),
    n_boot_valid = length(boot_ranges)
  )
})

cat("\n--- Formal test: does the irrigation-moderation gap (Delta_tau) vary across quantiles? ---\n")
print(range_test)
cat("\nInterpretation: boot_p_value is the share of bootstrap replications whose own\n")
cat("range (max-min of Delta_tau across the 5 quantiles) is at least as large as the\n")
cat("range we actually observe. A SMALL p-value means the observed range is unusually\n")
cat("large relative to what bootstrap sampling noise alone would produce, i.e. evidence\n")
cat("that irrigation's moderating effect genuinely differs across the yield distribution\n")
cat("for that crop. A LARGE p-value means the observed variation across quantiles is\n")
cat("consistent with a roughly constant moderation effect.\n")

# --- 5. Save everything -----------------------------------------------------------
wb <- createWorkbook()
addWorksheet(wb, "observed_delta_by_quantile")
writeData(wb, "observed_delta_by_quantile", observed_delta)
addWorksheet(wb, "cross_quantile_moderation_test")
writeData(wb, "cross_quantile_moderation_test", range_test)
saveWorkbook(wb, file.path(out_dir, "step18_cross_quantile_moderation_test.xlsx"), overwrite = TRUE)

cat("\nStep 18 complete. Output saved to:", out_dir, "\n")























# ==============================================================================
# QUANTILE STEP 20 — Lagged irrigation interaction: TMX_t x Irr_{t-1}
# (addresses GPT_v2 review Priority item 3)
# ==============================================================================
# Rationale: Section 4.2 already flags, in prose only, a concern that the
# contemporaneous equipped-irrigation ratio used throughout this paper is not
# necessarily independent of the same year's climate realization — a country
# experiencing an unusual heat/drought year could, in principle, adjust
# irrigation investment within that same year, which would make the
# irrigation measure partly a CONSEQUENCE of climate rather than purely a
# moderator of its effect. This step provides a more direct empirical check:
# it re-estimates the irrigation-interaction specification using the
# PREVIOUS year's equipped-irrigation ratio (Irr_{t-1}) interacted with the
# CURRENT year's temperature (TMX_t), instead of interacting TMX_t with the
# contemporaneous Irr_t.
#
# Using last year's irrigation infrastructure to explain this year's
# temperature-yield relationship is much harder to reverse-engineer through
# same-year adaptive irrigation investment (a farmer cannot retroactively
# change last year's already-built infrastructure in response to this
# year's heat), so if the moderation pattern survives under this lagged
# specification, that is meaningful evidence against the contemporaneous-
# endogeneity concern being the sole driver of the finding.
#
# This mirrors the exact structure of Step 14 (p25/p75 comparison) and
# Step 15 (lagged temperature), just applied to the irrigation side of the
# interaction instead of the temperature side.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)
set.seed(2026)
N_BOOT <- 1000

# --- 1. Load panels, build the one-year-lagged irrigation ratio ------------------
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))

# QUANTILE STEP 22 — Leave-one-decade-out sensitivity for the irrigation-
# moderation finding (partial, practical response to GPT_v2 Priority item 1:
# cross-sectional dependence / inference robustness)
# ==============================================================================
# Rationale: Section 2.5/3.4 already document that residual cross-sectional
# dependence is present for 7 of 8 crops, and that our country-block
# bootstrap does not capture same-year, cross-country common shocks (e.g. a
# global drought year, an El Nino event, a global commodity-price shock).
# GPT_v2's review flags this as the single biggest remaining inference risk,
# and asks for "the strongest possible robustness solution" — a year-cluster
# bootstrap variant, two-way resampling, or a leave-year-block sensitivity
# check.
#
# We investigated two-way cluster-robust variance estimators for quantile
# regression (Hounyo & Lin, 2026) and common-shock-robust panel quantile
# inference (Chiang, Galvao & Wei, 2026) in earlier work on this paper; both
# are recent methods developed for the CLASSICAL linear quantile regression
# estimator, and neither has an established extension to the moment-based
# location-scale representation of Machado and Santos Silva (2019) used
# throughout this paper. Implementing a genuinely new two-way bootstrap
# variance estimator for the location-scale MSS framework would be a
# substantial methodological contribution in its own right, well beyond the
# scope of what can be verified and validated within this paper.
#
# What we CAN do, and what this step provides, is a practical sensitivity
# check that does not require developing new inference theory: a
# leave-one-decade-out analysis. If the irrigation-moderation finding for
# wheat, maize, and rice is being driven by a handful of specific years with
# unusually strong common shocks (which the Pesaran CD test detects but
# cannot localize in time), removing an entire decade at a time and
# re-estimating should reveal that dependency — the point estimate should
# swing noticeably when a decade containing an influential common shock is
# excluded. If instead the point estimates are stable across all
# leave-one-decade-out re-estimations, that is at least suggestive (though
# not a formal proof) that the finding is not driven by a small number of
# temporally concentrated common-shock years.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops_focus <- c("wheat", "maize", "rice")   # the 3 crops carrying the central finding
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)
set.seed(2026)

# --- 1. Load and prepare panels for the 3 focus crops -----------------------------
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  read_excel(path)
}
panels_raw <- map(crops_focus, load_panel) %>% setNames(crops_focus)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita))
}
panels_raw <- map(panels_raw, prep_panel)

center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c = PRE_ann - mean(PRE_ann, na.rm = TRUE)
    )
}
panels_raw <- map(panels_raw, center_climate)

# --- 2. Define decade blocks across the 1961-2024 sample --------------------------
decade_blocks <- list(
  "1961-1970" = 1961:1970,
  "1971-1980" = 1971:1980,
  "1981-1990" = 1981:1990,
  "1991-2000" = 1991:2000,
  "2001-2010" = 2001:2010,
  "2011-2024" = 2011:2024   # last block slightly longer to cover the full sample
)

# --- 3. Same generic MSS pipeline helper as prior steps ---------------------------
run_mss_pipeline <- function(df, weight_col, formula_mean, formula_scale) {
  wt_formula <- as.formula(paste0("~", weight_col))
  
  mean_mod <- feols(as.formula(formula_mean), weights = wt_formula,
                    cluster = ~country, data = df)
  df$resid_tmp <- NA_real_
  df$resid_tmp[obs(mean_mod)] <- resid(mean_mod)
  
  df_scale_est <- df %>% filter(!is.na(resid_tmp))
  scale_mod <- feols(as.formula(formula_scale), weights = wt_formula,
                     cluster = ~country,
                     data = df_scale_est %>% mutate(abs_resid_tmp = abs(resid_tmp)))
  
  used_rows <- obs(scale_mod)
  df_scale_est$scale_hat <- NA_real_
  df_scale_est$scale_hat[used_rows] <- fitted(scale_mod)
  df <- df %>% left_join(df_scale_est %>% select(country, year, scale_hat),
                         by = c("country", "year"))
  
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df <- df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    std_resid = ifelse(!is.na(resid_tmp), resid_tmp / scale_hat_floored, NA_real_)
  )
  
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005); q_hi <- quantile(vals, 0.995)
  df <- df %>% mutate(std_resid_w = pmin(pmax(std_resid, q_lo), q_hi))
  
  q_tau <- quantile(df$std_resid_w[!is.na(df$std_resid_w)], probs = taus)
  
  list(mean_mod = mean_mod, scale_mod = scale_mod, q_tau = q_tau)
}

# --- 4. For each crop, for each decade EXCLUDED, re-estimate p25-vs-p75 ----------
run_leave_decade_out <- function(crop) {
  df_full <- panels_raw[[crop]]
  p25_val <- quantile(df_full$irr_ratio, 0.25, na.rm = TRUE)
  p75_val <- quantile(df_full$irr_ratio, 0.75, na.rm = TRUE)
  
  map_dfr(names(decade_blocks), function(decade_name) {
    years_to_exclude <- decade_blocks[[decade_name]]
    df_sub <- df_full %>% filter(!(year %in% years_to_exclude))
    
    res <- tryCatch(
      run_mss_pipeline(
        df_sub, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) {
      return(data.frame(crop = crop, decade_excluded = decade_name, tau = taus,
                        beta_tau_p25 = NA, beta_tau_p75 = NA, n_obs_remaining = nrow(df_sub)))
    }
    
    b_tmx <- coef(res$mean_mod)["TMX_c"]
    b_int <- coef(res$mean_mod)["TMX_c:irr_ratio"]
    g_tmx <- coef(res$scale_mod)["TMX_c"]
    g_int <- coef(res$scale_mod)["TMX_c:irr_ratio"]
    
    data.frame(
      crop = crop, decade_excluded = decade_name, tau = taus,
      beta_tau_p25 = as.numeric((b_tmx + b_int * p25_val) + res$q_tau * (g_tmx + g_int * p25_val)),
      beta_tau_p75 = as.numeric((b_tmx + b_int * p75_val) + res$q_tau * (g_tmx + g_int * p75_val)),
      n_obs_remaining = nrow(df_sub)
    )
  })
}

cat("Running leave-one-decade-out sensitivity for wheat, maize, rice...\n")
leave_decade_results <- map_dfr(crops_focus, run_leave_decade_out)

leave_decade_results <- leave_decade_results %>%
  mutate(moderation_gap = beta_tau_p75 - beta_tau_p25)


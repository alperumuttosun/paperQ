  map_dfr(seq_along(taus), function(i) {
    diff_vec <- mat25[, i] - mat75[, i]
    diff_vec <- diff_vec[!is.na(diff_vec)]
    point_diff <- lagged_irr_results$beta_tau_p25_lag[lagged_irr_results$crop == crop & lagged_irr_results$tau == taus[i]] -
      lagged_irr_results$beta_tau_p75_lag[lagged_irr_results$crop == crop & lagged_irr_results$tau == taus[i]]

# --- 2. Each crop's own p25/p75 of irr_ratio (same as Step 14) -------------------
irrigation_percentiles <- map_dfr(crops, function(crop) {
  vals <- panels_raw[[crop]]$irr_ratio
  vals <- vals[!is.na(vals)]
  data.frame(crop = crop, p25 = quantile(vals, 0.25), p75 = quantile(vals, 0.75))
})

# --- 3. Same generic MSS pipeline helper as Step 07/14 ----------------------------
run_mss_pipeline <- function(df, weight_col, formula_mean, formula_scale) {
  wt_formula <- as.formula(paste0("~", weight_col))
  
  mean_mod <- feols(as.formula(formula_mean), weights = wt_formula,
                    cluster = ~country, data = df)
  df$resid_tmp <- NA_real_
  df$resid_tmp[obs(mean_mod)] <- resid(mean_mod)
  
  df_scale_est <- df %>% filter(!is.na(resid_tmp))
  scale_mod <- feols(as.formula(formula_scale), weights = wt_formula,
                     cluster = ~country,
                     data = df_scale_est %>% mutate(abs_resid_tmp = abs(resid_tmp)))
  
  used_rows <- obs(scale_mod)
  df_scale_est$scale_hat <- NA_real_
  df_scale_est$scale_hat[used_rows] <- fitted(scale_mod)
  df <- df %>% left_join(df_scale_est %>% select(country, year, scale_hat),
                         by = c("country", "year"))
  
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df <- df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    std_resid = ifelse(!is.na(resid_tmp), resid_tmp / scale_hat_floored, NA_real_)
  )
  
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005); q_hi <- quantile(vals, 0.995)
  df <- df %>% mutate(std_resid_w = pmin(pmax(std_resid, q_lo), q_hi))
  
  q_tau <- quantile(df$std_resid_w[!is.na(df$std_resid_w)], probs = taus)
  
  list(mean_mod = mean_mod, scale_mod = scale_mod, q_tau = q_tau, df = df)
}

# --- 4. Fit the interaction model per crop, BASELINE weight, evaluate at p25/p75 -
run_p25_p75_crop_baseline_weight <- function(crop) {
  df <- panels_raw[[crop]]
  p25_val <- irrigation_percentiles$p25[irrigation_percentiles$crop == crop]
  p75_val <- irrigation_percentiles$p75[irrigation_percentiles$crop == crop]
  
  res <- run_mss_pipeline(
    df,
    weight_col    = "baseline_production_tonnes",
    formula_mean  = "ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year",
    formula_scale = "abs_resid_tmp ~ TMX_c + PRE_c + irr_ratio + ln_gdp + TMX_c:irr_ratio | country + year"
  )
  
  b_tmx <- coef(res$mean_mod)["TMX_c"]
  b_int <- coef(res$mean_mod)["TMX_c:irr_ratio"]
  g_tmx <- coef(res$scale_mod)["TMX_c"]
  g_int <- coef(res$scale_mod)["TMX_c:irr_ratio"]
  
  data.frame(
    crop = crop, tau = taus,
    p25_val = p25_val, p75_val = p75_val,
    beta_tau_p25_baseline = as.numeric((b_tmx + b_int * p25_val) + res$q_tau * (g_tmx + g_int * p25_val)),
    beta_tau_p75_baseline = as.numeric((b_tmx + b_int * p75_val) + res$q_tau * (g_tmx + g_int * p75_val))
  )
}

cat("Running baseline-weight p25-vs-p75 irrigation comparison for all crops...\n")

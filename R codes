# QUANTILE STEP 19 — Baseline-weight robustness for the IRRIGATION INTERACTION
# results (addresses GPT_v2 review Priority item 2)
# ==============================================================================
# Rationale: the existing weighting-robustness check (Step 07 Part A / this
# paper's Table 13) only re-estimates the TMX MAIN-EFFECT coefficients under
# a fixed baseline weighting period. It does not re-estimate the irrigation
# INTERACTION coefficients (the p25-versus-p75 moderation gap central to
# Section 3.2/4.2) under that same alternative weighting. This step closes
# that gap: it re-runs the p25-versus-p75 comparison from Step 14, but with
# country-year observations weighted by baseline_production_tonnes (a fixed
# 1990-2000 average, the same alternative weight already used in Step 07
# Part A) instead of contemporaneous production_tonnes.
#
# This tells us whether the CENTRAL irrigation-moderation finding — not just
# the TMX main effect — is sensitive to the choice of contemporaneous vs.
# fixed-period weighting.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)

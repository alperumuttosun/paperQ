  df <- read_panel(crop_name)
  if (is.null(df)) { cat(sprintf("[%s] panelv7 missing, skipped\n", crop_name)); next }
  
  baseline_vals <- compute_baseline(df)
  
  df <- df %>%
    dplyr::select(-dplyr::any_of(c("baseline_production_tonnes",
                                   "baseline_area_harvested_ha",
                                   "baseline_period_used",
                                   "baseline_is_fallback"))) %>%
    dplyr::left_join(baseline_vals, by = "Country_ISO")
  
  n_fallback <- length(unique(df$Country_ISO[df$baseline_is_fallback == 1]))
  n_total    <- length(unique(df$Country_ISO))
  cat(sprintf("[%-8s] baseline computed | fallback used for %d / %d countries\n",
              crop_name, n_fallback, n_total))
  
  if (n_fallback > 0) {
    fb_detail <- df %>%
      dplyr::filter(baseline_is_fallback == 1) %>%
      dplyr::distinct(Country_ISO, baseline_period_used) %>%
      dplyr::mutate(crop = crop_name)
    fallback_summary[[crop_name]] <- fb_detail
    print(fb_detail[, c("Country_ISO","baseline_period_used")], row.names = FALSE)
  }
  
  writexl::write_xlsx(df, panelv7_path)
  cat(sprintf("  [SAVED] %s (with baseline columns added)\n\n", basename(panelv7_path)))
}


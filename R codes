# ==============================================================================
# QUANTILE STEP 09 — Quadratic-TMX robustness check via MSS
# ==============================================================================
# Rationale: a preliminary check found TMX^2 to be unreliable / wrong-signed in the
# annual-mean design (Section 5.3) — a structural limitation, not a mistake:
# degree-day curvature requires within-season temperature-distribution data
# that an annual mean cannot recover. This step checks whether the SAME
# instability shows up when the quadratic term is carried through the MSS
# quantile machinery, i.e. does TMX^2 behave any better (or just as poorly)
# once we're looking at quantile-specific effects instead of the mean?
# Expectation, based on the preliminary check above: TMX^2 should remain unreliable
# here too — this step exists to CONFIRM that expectation with actual numbers,
# not to introduce a new curvature claim into the manuscript.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)
set.seed(2026)
N_BOOT <- 1000   # same rep count as the rest of the pipeline, for consistency

# --- 1. Load and prepare panels (same steps as Step01/Step07) --------------------
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  read_excel(path)
}
panels_raw <- map(crops, load_panel) %>% setNames(crops)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita))
}
panels_raw <- map(panels_raw, prep_panel)

center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c  = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c  = PRE_ann - mean(PRE_ann, na.rm = TRUE),
      TMX_sq = TMX_c^2   # quadratic term built from the CENTERED variable,
      # consistent with the convention used throughout this pipeline for TMX^2
    )
}
panels_raw <- map(panels_raw, center_climate)

# --- 2. Same generic MSS pipeline helper as Step 07 (self-contained here) --------
run_mss_pipeline <- function(df, weight_col, formula_mean, formula_scale) {
  wt_formula <- as.formula(paste0("~", weight_col))
  
  mean_mod <- feols(as.formula(formula_mean), weights = wt_formula,
                    cluster = ~country, data = df)
  df$resid_tmp <- NA_real_
  df$resid_tmp[obs(mean_mod)] <- resid(mean_mod)
  
  df_scale_est <- df %>% filter(!is.na(resid_tmp))
  scale_mod <- feols(as.formula(formula_scale), weights = wt_formula,
                     cluster = ~country,
                     data = df_scale_est %>% mutate(abs_resid_tmp = abs(resid_tmp)))
  
  used_rows <- obs(scale_mod)
  df_scale_est$scale_hat <- NA_real_
  df_scale_est$scale_hat[used_rows] <- fitted(scale_mod)
  df <- df %>% left_join(df_scale_est %>% select(country, year, scale_hat),
                         by = c("country", "year"))
  
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df <- df %>% mutate(
    scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat),
    std_resid = ifelse(!is.na(resid_tmp), resid_tmp / scale_hat_floored, NA_real_)
  )
  
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005); q_hi <- quantile(vals, 0.995)
  df <- df %>% mutate(std_resid_w = pmin(pmax(std_resid, q_lo), q_hi))
  
  q_tau <- quantile(df$std_resid_w[!is.na(df$std_resid_w)], probs = taus)
  
  list(mean_mod = mean_mod, scale_mod = scale_mod, q_tau = q_tau, df = df)
}

# --- 3. Fit the quadratic-TMX MSS model per crop, recover beta_tau for TMX ------
#         AND for TMX^2, at each quantile ------------------------------------------
run_quadratic_crop <- function(crop) {
  df <- panels_raw[[crop]]
  
  res <- run_mss_pipeline(
    df,
    weight_col    = "production_tonnes",
    formula_mean  = "ln_yield ~ TMX_c + TMX_sq + PRE_c + irr_ratio + ln_gdp | country + year",
    formula_scale = "abs_resid_tmp ~ TMX_c + TMX_sq + PRE_c + irr_ratio + ln_gdp | country + year"
  )
  
  b_tmx <- coef(res$mean_mod)["TMX_c"]
  b_sq  <- coef(res$mean_mod)["TMX_sq"]
  g_tmx <- coef(res$scale_mod)["TMX_c"]
  g_sq  <- coef(res$scale_mod)["TMX_sq"]
  
  data.frame(
    crop = crop, tau = taus,
    beta_tau_TMX    = as.numeric(b_tmx + res$q_tau * g_tmx),
    beta_tau_TMXsq  = as.numeric(b_sq  + res$q_tau * g_sq)
  )
}

cat("Running quadratic-TMX MSS pipeline for all crops...\n")
quad_results <- map_dfr(crops, run_quadratic_crop)
print(quad_results)

# --- 4. Bootstrap for both TMX and TMX^2 quantile coefficients -------------------
bootstrap_quadratic <- function(crop, n_boot = N_BOOT) {
  df <- panels_raw[[crop]]
  countries <- unique(df$country)
  n_c <- length(countries)
  boot_tmx <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  boot_sq  <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  
  for (b in seq_len(n_boot)) {
    sampled <- sample(countries, n_c, replace = TRUE)
    boot_df <- map_dfr(seq_along(sampled), function(i) {
      sub <- df %>% filter(country == sampled[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_c + TMX_sq + PRE_c + irr_ratio + ln_gdp | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_c + TMX_sq + PRE_c + irr_ratio + ln_gdp | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    
    b_tmx <- coef(res$mean_mod)["TMX_c"]; b_sq <- coef(res$mean_mod)["TMX_sq"]
    g_tmx <- coef(res$scale_mod)["TMX_c"]; g_sq <- coef(res$scale_mod)["TMX_sq"]
    if (any(is.na(c(b_tmx, b_sq, g_tmx, g_sq)))) next
    
    boot_tmx[b, ] <- as.numeric(b_tmx + res$q_tau * g_tmx)
    boot_sq[b, ]  <- as.numeric(b_sq  + res$q_tau * g_sq)
  }
  colnames(boot_tmx) <- paste0("tau_", taus)
  colnames(boot_sq)  <- paste0("tau_", taus)
  list(boot_tmx = boot_tmx, boot_sq = boot_sq)
}

cat("Running quadratic-TMX bootstrap (", N_BOOT, "reps per crop) — this will take a while...\n")
quad_boot <- map(crops, ~ bootstrap_quadratic(.x)) %>% setNames(crops)

quad_se <- map_dfr(crops, function(crop) {
  mat_tmx <- quad_boot[[crop]]$boot_tmx
  mat_sq  <- quad_boot[[crop]]$boot_sq
  data.frame(
    crop = crop, tau = taus,
    se_TMX   = apply(mat_tmx, 2, sd, na.rm = TRUE),
    se_TMXsq = apply(mat_sq,  2, sd, na.rm = TRUE)
  )
})

quad_results <- quad_results %>%
  left_join(quad_se, by = c("crop", "tau")) %>%
  mutate(
    ci_low_TMX    = beta_tau_TMX   - 1.96 * se_TMX,
    ci_high_TMX   = beta_tau_TMX   + 1.96 * se_TMX,
    ci_low_TMXsq  = beta_tau_TMXsq - 1.96 * se_TMXsq,
    ci_high_TMXsq = beta_tau_TMXsq + 1.96 * se_TMXsq,
    TMXsq_sig     = !(ci_low_TMXsq <= 0 & ci_high_TMXsq >= 0)
  )
print(quad_results)

# --- 5. Reportable summary: how often does TMX^2 flip sign or lose significance --
# across quantiles, per crop? This is the number that lets the manuscript state
# plainly whether the quantile version of the curvature term is any more
# reliable than the mean-model version checked above (expectation: no).
quad_summary <- quad_results %>%
  group_by(crop) %>%
  summarise(
    n_quantiles_sig     = sum(TMXsq_sig, na.rm = TRUE),
    sign_changes_across_quantiles = length(unique(sign(beta_tau_TMXsq))) > 1,
    .groups = "drop"
  )
print(quad_summary)

# --- 6. Save everything -----------------------------------------------------------
saveRDS(list(quad_results = quad_results, quad_boot = quad_boot, quad_summary = quad_summary),
        file.path(out_dir, "step09_quadratic_robustness.rds"))

wb <- createWorkbook()
addWorksheet(wb, "quadratic_beta_tau_results")
writeData(wb, "quadratic_beta_tau_results", quad_results)
addWorksheet(wb, "quadratic_summary_by_crop")
writeData(wb, "quadratic_summary_by_crop", quad_summary)

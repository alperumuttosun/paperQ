# ==============================================================================
# QUANTILE STEP 12 — Pesaran CD test (supplementary cross-sectional-dependence
#                     diagnostic), applied to resid_mean (the baseline TWFE
#                     mean-model residuals from Step 01)
# ==============================================================================
# Rationale: the Pesaran CD test checks for cross-sectional dependence in
# the mean-effect (TWFE) model residuals. This project's quantile (MSS)
# estimator gets its standard errors from a country-block bootstrap, which
# does NOT itself test for cross-sectional dependence (it only preserves
# within-country serial dependence, not common-year shocks across countries).
# Driscoll-Kraay cannot be mechanically attached to the MSS bootstrap (see
# in-code notes below), so this diagnostic is added as a SUPPLEMENTARY check
# on the TWFE mean-model residuals only — it tells us whether the
# MEAN specification shows cross-sectional dependence, which is informative
# context but NOT a formal validity test of the MSS quantile estimator itself.
# This distinction must be preserved in how results are reported.

# --- 0. Setup ------------------------------------------------------------------
# install.packages("plm") # provides pcdtest(), the standard Pesaran CD implementation
library(plm)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

# --- 1. Reload panels and rebuild resid_mean (same steps as Step01) ----------------
# We rebuild rather than reload Step01's saved residual panels, since this
# keeps the script self-contained and avoids depending on which intermediate
# file version is on disk.
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  read_excel(path)
}
panels <- map(crops, load_panel) %>% setNames(crops)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita))
}
panels <- map(panels, prep_panel)

center_climate <- function(df) {
  df %>%
    mutate(
      TMX_c = TMX_ann - mean(TMX_ann, na.rm = TRUE),
      PRE_c = PRE_ann - mean(PRE_ann, na.rm = TRUE)
    )
}
panels <- map(panels, center_climate)

# --- 2. Run the mean equation (same specification as Step01) and extract residuals ---
library(fixest)
run_mean_model <- function(crop) {
  df <- panels[[crop]]
  mod <- feols(
    ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes, cluster = ~country, data = df
  )
  df$resid_mean <- NA_real_
  df$resid_mean[obs(mod)] <- resid(mod)
  df
}
panels <- map(crops, run_mean_model) %>% setNames(crops)

# --- 3. Pesaran CD test, per crop ------------------------------------------------
# pcdtest() needs a balanced-ish panel data frame indexed by (country, year).
# It tests H0: cross-sectional independence of the residuals, using pairwise
# correlations across all country pairs at the same time point. A significant
# result (small p-value) means residuals ARE cross-sectionally correlated —
# i.e. countries' unexplained yield shocks tend to move together in the same
# years, consistent with common climate/market shocks.
run_pesaran_cd <- function(crop) {
  df <- panels[[crop]] %>% filter(!is.na(resid_mean))
  
  pdata <- pdata.frame(df, index = c("country", "year"))
  
  cd_result <- tryCatch(
    pcdtest(resid_mean ~ 1, data = pdata, model = "pooling"),
    error = function(e) NULL
  )
  
  if (is.null(cd_result)) {
    return(data.frame(crop = crop, cd_statistic = NA_real_, p_value = NA_real_,
                      n_countries = n_distinct(df$country), note = "test failed to run"))
  }
  
  data.frame(
    crop         = crop,
    cd_statistic = unname(cd_result$statistic),
    p_value      = cd_result$p.value,
    n_countries  = n_distinct(df$country),
    note         = ""
  )
}

cat("Running Pesaran CD test on resid_mean for each crop...\n")
cd_results <- map_dfr(crops, run_pesaran_cd)
print(cd_results)
# Interpretation: p_value < 0.05 suggests cross-sectional dependence is
# present in the mean-model residuals for that crop — informative context for
# the manuscript's discussion, but again, this is a diagnostic on the TWFE
# mean model, not a formal statement about the MSS quantile estimator's own
# inference validity.

# --- 4. Save output --------------------------------------------------------------
saveRDS(cd_results, file.path(out_dir, "step12_pesaran_cd_diagnostic.rds"))


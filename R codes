# QUANTILE STEP 15 — Lagged-temperature robustness check
# ==============================================================================
# Rationale: all analyses so far use the SAME-YEAR (contemporaneous) annual
# maximum-temperature exposure, TMX_ann. This step asks whether the paper's
# two main findings — (1) no significant q10-vs-q90 distributional asymmetry,
# and (2) equipped-irrigation moderation for wheat/maize/rice — are specific
# to contemporaneous temperature, or whether they also hold when temperature
# is measured with a one-year lag (TMX in year t-1 predicting yield in year t).
#
# This is NOT a claim that lagged temperature is a "better" measure — it is a
# robustness check on whether the paper's conclusions are sensitive to this
# specific timing choice. A one-year lag is a natural, simple alternative:
# it could capture, for example, delayed soil-moisture or input-planning
# effects of the previous year's heat, without requiring any new data beyond
# what is already in the panel.
#
# IMPORTANT: this uses the EXACT SAME MSS pipeline, weighting, bootstrap
# design, and quantile levels as the rest of the paper — only the temperature
# variable itself is replaced by its one-year lag. Nothing else changes.

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(readxl)
library(openxlsx)

data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)
set.seed(2026)
N_BOOT <- 1000

# --- 1. Load and prepare panels, build the one-year-lagged TMX variable ----------
load_panel <- function(crop) {
  path <- file.path(data_dir, paste0("panelv7_", crop, ".xlsx"))
  read_excel(path)
}
panels_raw <- map(crops, load_panel) %>% setNames(crops)

prep_panel <- function(df) {
  df %>%
    rename(country = Country_ISO, year = Yil) %>%
    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita)) %>%
    arrange(country, year) %>%
    group_by(country) %>%
    # TMX_lag1 = the SAME country's TMX_ann from the PREVIOUS year. The first
    # year of each country's series has no prior year, so it becomes NA and is
    # dropped automatically by feols later, exactly like any other missing value.
    mutate(TMX_lag1 = dplyr::lag(TMX_ann, n = 1, order_by = year)) %>%
    ungroup()
}
panels_raw <- map(panels_raw, prep_panel)

# centering: use the SAME pooled-mean convention as the contemporaneous
# specification, but centered on the lagged variable's own mean (so the two
# specifications are each internally consistent, following Section 3.2's
# centering convention applied to whichever temperature variable is in use)
center_climate <- function(df) {
  df %>%
    mutate(
      TMX_lag1_c = TMX_lag1 - mean(TMX_lag1, na.rm = TRUE),
      PRE_c      = PRE_ann  - mean(PRE_ann,  na.rm = TRUE)
    )
}
panels_raw <- map(panels_raw, center_climate)

# quick check: how many rows get dropped per crop just from the lag (should be

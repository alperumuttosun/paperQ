  data.frame(crop = crop,
             n_total = nrow(df),
             n_lag_na = sum(is.na(df$TMX_lag1)),
             n_countries = n_distinct(df$country))
})
print(lag_dropped)

# --- 2. Mean-model coefficient using lagged TMX ---------------------------------
run_lag_mean_model <- function(crop) {
  df <- panels_raw[[crop]]
  mod <- feols(
    ln_yield ~ TMX_lag1_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes, cluster = ~country, data = df
  )
  df$resid_lag <- NA_real_
  df$resid_lag[obs(mod)] <- resid(mod)
  list(model = mod, data = df)
}
lag_mean_results <- map(crops, run_lag_mean_model) %>% setNames(crops)

lag_mean_check <- map_dfr(crops, function(crop) {
  mod <- lag_mean_results[[crop]]$model
  data.frame(crop = crop, TMX_lag1_coef = coef(mod)["TMX_lag1_c"],

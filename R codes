    mutate(ln_yield = log(yield_hg_per_ha), ln_gdp = log(GDP_per_Capita)) %>%
    arrange(country, year) %>%
    group_by(country) %>%
    # Irr_lag1 = the SAME country's irr_ratio from the PREVIOUS year. Exactly
    # the same lag logic already used for TMX in Step 15, just applied to
    # the irrigation variable instead.
    mutate(irr_ratio_lag1 = dplyr::lag(irr_ratio, n = 1, order_by = year)) %>%
    ungroup()
}
panels_raw <- map(panels_raw, prep_panel)


# Scale check: if abs(mean) > 100 the INT16 x 0.1 factor was not applied
check_scale <- function(v, var_name) {
  if (abs(mean(v, na.rm = TRUE)) > 100) {
    cat("  [SCALE]", var_name, "0.1 applied\n")
    return(v * 0.1)
  }
  return(v)
}

# CRU's pet variable is a DAILY-RATE potential evapotranspiration (mm/day)
# for each month, NOT a monthly total -- unlike pre, which is already a
# monthly total. Summing 12 monthly pet values directly (as if they were
# already monthly totals) undercounts true annual PET by a factor of
# roughly 30 (the average number of days per month). This helper returns
# the correct day count for a given year/month (leap-year aware), used to
# convert pet (mm/day) into a monthly total (mm/month) before summing to
# get PET_ann (mm/year).
days_in_month_of <- function(yil, ay) {
  d1 <- as.Date(sprintf("%04d-%02d-01", yil, ay))
  d2 <- as.Date(ifelse(ay == 12,
                       sprintf("%04d-01-01", yil + 1),
                       sprintf("%04d-%02d-01", yil, ay + 1)))
  as.integer(d2 - d1)
}



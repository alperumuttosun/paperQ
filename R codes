# --- 5. Bootstrap for lagged-TMX quantile coefficients + q10-vs-q90 test ---------
bootstrap_lag_crop <- function(crop, n_boot = N_BOOT) {
  df <- panels_raw[[crop]]
  countries <- unique(df$country)
  n_c <- length(countries)
  boot_betas <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  
  for (b in seq_len(n_boot)) {
    sampled <- sample(countries, n_c, replace = TRUE)
    boot_df <- map_dfr(seq_along(sampled), function(i) {
      sub <- df %>% filter(country == sampled[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    res <- tryCatch(
      run_mss_pipeline(
        boot_df, weight_col = "production_tonnes",
        formula_mean  = "ln_yield ~ TMX_lag1_c + PRE_c + irr_ratio + ln_gdp | country + year",
        formula_scale = "abs_resid_tmp ~ TMX_lag1_c + PRE_c + irr_ratio + ln_gdp | country + year"
      ),
      error = function(e) NULL
    )
    if (is.null(res)) next
    b_coef <- coef(res$mean_mod)["TMX_lag1_c"]
    g_coef <- coef(res$scale_mod)["TMX_lag1_c"]
    if (any(is.na(c(b_coef, g_coef)))) next
    boot_betas[b, ] <- as.numeric(b_coef + res$q_tau * g_coef)
  }
  colnames(boot_betas) <- paste0("tau_", taus)
  boot_betas
}

cat("Running lagged-TMX bootstrap (", N_BOOT, "reps per crop) — this will take a while...\n")
lag_boot <- map(crops, ~ bootstrap_lag_crop(.x)) %>% setNames(crops)

lag_se <- map_dfr(crops, function(crop) {

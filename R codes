    lag_quantile_results$beta_tau_lag[lag_quantile_results$crop == crop & lag_quantile_results$tau == 0.90]
  
  se_diff <- sd(diff_vec)
  p_val <- if (point_diff < 0) 2 * mean(diff_vec >= 0) else 2 * mean(diff_vec <= 0)
  p_val <- min(p_val, 1)
  
  data.frame(crop = crop, q10_minus_q90_lag = point_diff, boot_se_diff = se_diff,
             p_value_boot = p_val, significant_05 = p_val < 0.05)
})

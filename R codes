# ==============================================================================
# QUANTILE STEP 03 — Standardize residuals, recover quantile-specific TMX effects
#                     (Machado & Santos Silva 2019, Steps 3-4), bootstrap SEs
# Paper_Quantile
# ==============================================================================
# Goal: turn the mean-regression coefficient (Step 01, beta_hat) and the
# scale-regression coefficient (Step 02, gamma_hat) into FIVE separate
# TMX effects — one for each quantile of the yield distribution (q10, q25,
# q50, q75, q90) — following the MSS "quantiles via moments" formula:
#
#     beta_tau = beta_hat + q_tau * gamma_hat
#
# where q_tau is the tau-th empirical quantile of the STANDARDIZED residuals
# (resid_mean / scale_hat). This is the step that finally answers the paper's
# question: is TMX's effect on yield bigger at the low end of the yield
# distribution than at the high end?

# --- 0. Setup ------------------------------------------------------------------
library(fixest)
library(dplyr)
library(purrr)
library(openxlsx)

# --- 1. Load Step 02 output -----------------------------------------------------
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
taus  <- c(0.10, 0.25, 0.50, 0.75, 0.90)   # the 5 quantiles we report

panels <- readRDS(file.path(out_dir, "step02_scale_panels.rds"))

# We also need the raw mean/scale models (for their coefficient vectors) —
# reload them by re-running Step 01/02's regressions here, quickly, rather
# than re-saving model objects (keeps this script self-contained).
# NOTE: this refits the SAME two regressions from Steps 01-02; it does not
# change any results, it's just how we get clean access to beta_hat/gamma_hat.
refit_beta_gamma <- function(crop) {
  df <- panels[[crop]]
  
  mean_mod <- feols(
    ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes, cluster = ~country, data = df
  )
  scale_mod <- feols(
    abs(resid_mean) ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
    weights = ~production_tonnes, cluster = ~country,
    data = df %>% filter(!is.na(resid_mean))
  )
  
  list(beta = coef(mean_mod), gamma = coef(scale_mod))
}
beta_gamma <- map(crops, refit_beta_gamma) %>% setNames(crops)

# --- 2. Floor non-positive scale_hat values --------------------------------------
# A small number of rows per crop (see Step 02) have scale_hat <= 0, a known
# quirk of linearly fitting an absolute value. We floor these at a small
# positive epsilon (1% of that crop's median positive scale_hat) so division
# in the next step doesn't produce Inf/NaN or flip signs. This affects only
# ~1-4 rows per crop out of thousands.
floor_scale <- function(df) {
  med_pos <- median(df$scale_hat[df$scale_hat > 0], na.rm = TRUE)
  eps <- 0.01 * med_pos
  df %>% mutate(scale_hat_floored = ifelse(scale_hat <= 0, eps, scale_hat))
}
panels <- map(panels, floor_scale)

# --- 3. Standardize residuals ------------------------------------------------------
# standardized_resid = resid_mean / scale_hat_floored
# Only defined where resid_mean is non-missing (same mean-equation estimation sample as before).
standardize <- function(df) {
  df %>% mutate(
    std_resid = ifelse(!is.na(resid_mean), resid_mean / scale_hat_floored, NA_real_)
  )
}
panels <- map(panels, standardize)

# --- 3b. Winsorize std_resid (Step 05/05b follow-up) --------------------------------
# Diagnostics (Step 05, Step 05b) found that a small number of country-years with
# near-zero fitted scale (concentrated in a few low-yield-variance countries, e.g.
# Japan for maize, Uzbekistan for oats, Peru for oats/soybean, Jordan for sorghum)
# produce extreme std_resid values (some beyond |500|) that badly distort the
# standardized-residual distribution's mean and skewness, violating MSS's E[u]=0
# assumption well beyond what the raw floor fix alone resolved. Trimming the most
# extreme 1% (0.5% each tail) was shown in Step 05b to fix most of the skewness
# problem, so we apply that same winsorizing here as the PRIMARY specification —
# raw (non-winsorized) diagnostics remain saved separately (Step 05/05b outputs)
# so the manuscript can show both and explain why winsorizing was necessary.
winsorize_std_resid <- function(df) {
  vals <- df$std_resid[!is.na(df$std_resid)]
  q_lo <- quantile(vals, 0.005)
  q_hi <- quantile(vals, 0.995)
  df %>% mutate(
    std_resid_raw       = std_resid,   # keep the untouched version for reference
    std_resid_winsorized = pmin(pmax(std_resid, q_lo), q_hi),
    was_winsorized       = !is.na(std_resid) & (std_resid < q_lo | std_resid > q_hi)
  )
}
panels <- map(panels, winsorize_std_resid)

# quick summary of how many rows were winsorized per crop, for the manuscript
winsorize_summary <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  n_valid <- sum(!is.na(df$std_resid))
  n_wins  <- sum(df$was_winsorized, na.rm = TRUE)
  data.frame(crop = crop, n_valid = n_valid, n_winsorized = n_wins,
             pct_winsorized = round(100 * n_wins / n_valid, 3))
})
print(winsorize_summary)

# --- 4. Compute empirical quantiles of standardized residuals, per crop -------------
# q_tau here is a SINGLE number per crop per tau (not per observation) —
# it's the tau-th quantile of that crop's whole standardized-residual
# distribution, following the MSS formula.
compute_q_tau <- function(df) {
  vals <- df$std_resid_winsorized[!is.na(df$std_resid_winsorized)]
  quantile(vals, probs = taus, na.rm = TRUE)
}
q_tau_by_crop <- map(panels, compute_q_tau) %>% setNames(crops)

# --- 5. Recover quantile-specific TMX coefficients: beta_tau = beta + q_tau*gamma ---
recover_beta_tau <- function(crop) {
  b <- beta_gamma[[crop]]$beta["TMX_c"]
  g <- beta_gamma[[crop]]$gamma["TMX_c"]
  qs <- q_tau_by_crop[[crop]]
  
  data.frame(
    crop     = crop,
    tau      = taus,
    q_tau    = as.numeric(qs),
    beta_tau = as.numeric(b + qs * g)
  )
}
beta_tau_table <- map_dfr(crops, recover_beta_tau)
print(beta_tau_table)

# --- 6. Block bootstrap for standard errors on beta_tau -----------------------------
# We resample COUNTRIES with replacement (not individual rows) to preserve each
# country's full time series and its within-country serial correlation — this
# matches the country-clustering logic used everywhere else in this
# pipeline (Bertrand et al. 2004 rationale). For each replication we: (1) rebuild
# a bootstrap panel from resampled countries, (2) refit the mean and scale
# regressions, (3) recompute q_tau and beta_tau. The SD of beta_tau across
# replications is our bootstrap SE.
set.seed(2026)
N_BOOT <- 1000   # publication-standard rep count (raised from an initial 200-rep pilot run)

bootstrap_one_crop <- function(crop, n_boot = N_BOOT) {
  df <- panels[[crop]]
  countries <- unique(df$country)
  n_c <- length(countries)
  
  boot_betas <- matrix(NA_real_, nrow = n_boot, ncol = length(taus))
  
  for (b in seq_len(n_boot)) {
    sampled_countries <- sample(countries, n_c, replace = TRUE)
    # rebuild a panel where resampled countries keep their full original rows;
    # duplicate-sampled countries get a unique suffix so fixed effects don't
    # collide with each other inside feols
    boot_df <- map_dfr(seq_along(sampled_countries), function(i) {
      sub <- df %>% filter(country == sampled_countries[i])
      sub$country <- paste0(sub$country, "_b", i)
      sub
    })
    
    mean_mod_b <- tryCatch(
      feols(ln_yield ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
            weights = ~production_tonnes, data = boot_df),
      error = function(e) NULL
    )
    if (is.null(mean_mod_b)) next
    
    boot_df$resid_b <- NA_real_
    boot_df$resid_b[obs(mean_mod_b)] <- resid(mean_mod_b)
    
    scale_mod_b <- tryCatch(
      feols(abs(resid_b) ~ TMX_c + PRE_c + irr_ratio + ln_gdp | country + year,
            weights = ~production_tonnes,
            data = boot_df %>% filter(!is.na(resid_b))),
      error = function(e) NULL
    )
    if (is.null(scale_mod_b)) next
    
    vals <- boot_df$resid_b[!is.na(boot_df$resid_b)]
    scale_fit <- fitted(scale_mod_b)
    scale_fit[scale_fit <= 0] <- median(scale_fit[scale_fit > 0], na.rm = TRUE) * 0.01
    std_resid_b <- boot_df$resid_b[obs(scale_mod_b)] / scale_fit
    # apply the SAME winsorizing rule (trim most extreme 0.5% each tail) used in
    # the main specification, so bootstrap SEs reflect the winsorized estimator,
    # not the raw one — keeps the bootstrap consistent with what's reported.
    q_lo_b <- quantile(std_resid_b, 0.005, na.rm = TRUE)
    q_hi_b <- quantile(std_resid_b, 0.995, na.rm = TRUE)
    std_resid_b <- pmin(pmax(std_resid_b, q_lo_b), q_hi_b)
    q_b <- quantile(std_resid_b, probs = taus, na.rm = TRUE)
    
    beta_b  <- coef(mean_mod_b)["TMX_c"]
    gamma_b <- coef(scale_mod_b)["TMX_c"]
    boot_betas[b, ] <- as.numeric(beta_b + q_b * gamma_b)
  }
  
  colnames(boot_betas) <- paste0("tau_", taus)
  boot_betas
}

cat("Running block bootstrap (", N_BOOT, "reps per crop ) — this may take a while...\n")
boot_results <- map(crops, ~ bootstrap_one_crop(.x)) %>% setNames(crops)

# --- 7. Summarize bootstrap SEs and attach to beta_tau_table -----------------------
boot_se_table <- map_dfr(crops, function(crop) {
  mat <- boot_results[[crop]]
  ses <- apply(mat, 2, sd, na.rm = TRUE)
  data.frame(crop = crop, tau = taus, boot_se = as.numeric(ses))
})

beta_tau_table <- beta_tau_table %>%
  left_join(boot_se_table, by = c("crop", "tau")) %>%
  mutate(
    ci_low  = beta_tau - 1.96 * boot_se,
    ci_high = beta_tau + 1.96 * boot_se
  )
print(beta_tau_table)

# --- 8b. Post-winsorizing moment check (E[u]=0, E[|u|]=1) for the robustness table --
# Reports the same diagnostics as Step 05, but on the WINSORIZED std_resid, so the
# manuscript can show side-by-side: raw (Step 05's numbers) vs. winsorized (here).
post_winsorize_moments <- map_dfr(crops, function(crop) {
  df <- panels[[crop]]
  vals <- df$std_resid_winsorized[!is.na(df$std_resid_winsorized)]
  data.frame(
    crop       = crop,
    mean_u     = mean(vals),
    mean_abs_u = mean(abs(vals)),
    sd_u       = sd(vals),
    skewness_u = mean((vals - mean(vals))^3) / sd(vals)^3,
    n          = length(vals)
  )
})
print(post_winsorize_moments)

# --- 9. Save everything ------------------------------------------------------------
saveRDS(list(beta_tau_table = beta_tau_table, boot_results = boot_results,
             winsorize_summary = winsorize_summary,
             post_winsorize_moments = post_winsorize_moments),
        file.path(out_dir, "step03_quantile_results.rds"))

wb <- createWorkbook()
addWorksheet(wb, "beta_tau_results")
writeData(wb, "beta_tau_results", beta_tau_table)
addWorksheet(wb, "winsorize_summary")
writeData(wb, "winsorize_summary", winsorize_summary)
addWorksheet(wb, "post_winsorize_moments")
writeData(wb, "post_winsorize_moments", post_winsorize_moments)
saveWorkbook(wb, file.path(out_dir, "step03_quantile_results.xlsx"), overwrite = TRUE)

cat("\nStep 03 complete. Output saved to:", out_dir, "\n")
















# ==============================================================================
# QUANTILE STEP 04 — Formal test: is beta(q10) significantly different from
#                     beta(q90)? Uses the SAME bootstrap replications from
#                     Step 03 (not a new bootstrap) to test the DIFFERENCE.
# Paper_Quantile
# ==============================================================================
# Why this matters: Step 03 gave us point estimates suggesting TMX's effect is
# bigger (more negative) at q10 than at q90 for 6 of 8 crops. But comparing two
# point estimates informally isn't a real significance test — the two quantile
# effects come from the SAME underlying data, so they're correlated, and we
# need to account for that correlation properly. The cleanest way to do this
# with our existing bootstrap output is to compute the DIFFERENCE
# (beta_q10 - beta_q90) WITHIN each bootstrap replication, then look at the
# spread of that difference across replications. This automatically accounts
# for the correlation between q10 and q90 estimates, because both come from
# the same resampled dataset in each replication.

# --- 0. Setup ------------------------------------------------------------------
library(dplyr)
library(purrr)
library(openxlsx)

# --- 1. Load Step 03 output (point estimates + raw bootstrap matrices) -----------
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
out_dir  <- file.path(data_dir, "quantile_output")
crops <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

step03 <- readRDS(file.path(out_dir, "step03_quantile_results.rds"))
beta_tau_table <- step03$beta_tau_table
boot_results   <- step03$boot_results   # list of matrices, one per crop, columns tau_0.1...tau_0.9

# --- 2. For each crop, compute (q10 - q90) in EVERY bootstrap replication --------
# boot_results[[crop]] is an n_boot x 5 matrix with columns tau_0.1, tau_0.25,
# tau_0.5, tau_0.75, tau_0.9. We just need the first and last columns.
compute_q10_q90_diff <- function(crop) {
  mat <- boot_results[[crop]]
  diff_vec <- mat[, "tau_0.1"] - mat[, "tau_0.9"]
  diff_vec <- diff_vec[!is.na(diff_vec)]   # drop any failed bootstrap reps
  
  point_diff <- beta_tau_table$beta_tau[beta_tau_table$crop == crop & beta_tau_table$tau == 0.10] -
    beta_tau_table$beta_tau[beta_tau_table$crop == crop & beta_tau_table$tau == 0.90]
  
  boot_se_diff <- sd(diff_vec)
  ci_low  <- point_diff - 1.96 * boot_se_diff
  ci_high <- point_diff + 1.96 * boot_se_diff
  
  # two-sided bootstrap p-value: proportion of replications where the
  # difference crosses zero relative to the point estimate's sign, doubled
  # (standard percentile-based approach for a bootstrap significance test)
  if (point_diff < 0) {
    p_value <- 2 * mean(diff_vec >= 0)
  } else {
    p_value <- 2 * mean(diff_vec <= 0)
  }
  p_value <- min(p_value, 1)   # cap at 1, in case of small-sample overshoot
  
  data.frame(
    crop            = crop,
    q10_minus_q90   = point_diff,
    boot_se_diff    = boot_se_diff,
    ci_low          = ci_low,
    ci_high         = ci_high,
    p_value_boot    = p_value,
    significant_05  = p_value < 0.05,
    n_valid_boot    = length(diff_vec)
  )
}

q10_q90_test <- map_dfr(crops, compute_q10_q90_diff)
print(q10_q90_test)

# --- 3. Interpretation guide printed to console -----------------------------------
cat("\n--- Interpretation ---\n")
cat("q10_minus_q90 < 0 means TMX's effect is MORE NEGATIVE (stronger) at the\n")
cat("low end of the yield distribution than at the high end — i.e. the pattern\n")
cat("this paper's hypothesis expects. A crop with significant_05 = TRUE has\n")
cat("this asymmetry supported at the 5% level; FALSE means we cannot rule out\n")
cat("that q10 and q90 effects are actually the same, given sampling noise.\n")

# --- 4. Save output ------------------------------------------------------------
saveRDS(q10_q90_test, file.path(out_dir, "step04_q10_q90_test.rds"))

wb <- createWorkbook()

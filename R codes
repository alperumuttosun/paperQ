    ci_high_p75 = beta_tau_p75 + 1.96 * se_p75
  )

# --- 6. Formal test: is the p25-vs-p75 gap itself significant? -------------------
p25_p75_gap_test <- map_dfr(crops, function(crop) {
  mat25 <- p25_p75_boot[[crop]]$boot_p25
  mat75 <- p25_p75_boot[[crop]]$boot_p75
  map_dfr(seq_along(taus), function(i) {
    diff_vec <- mat25[, i] - mat75[, i]
    diff_vec <- diff_vec[!is.na(diff_vec)]
    point_diff <- p25_p75_results$beta_tau_p25[p25_p75_results$crop == crop & p25_p75_results$tau == taus[i]] -
      p25_p75_results$beta_tau_p75[p25_p75_results$crop == crop & p25_p75_results$tau == taus[i]]
    if (length(diff_vec) < 10) {
      return(data.frame(crop = crop, tau = taus[i], p25_minus_p75 = point_diff,
                        boot_se_diff = NA_real_, p_value_boot = NA_real_, significant_05 = NA))
    }
    se_diff <- sd(diff_vec)
    p_val <- if (point_diff < 0) 2 * mean(diff_vec >= 0) else 2 * mean(diff_vec <= 0)
    p_val <- min(p_val, 1)
    data.frame(crop = crop, tau = taus[i], p25_minus_p75 = point_diff,
               boot_se_diff = se_diff, p_value_boot = p_val, significant_05 = p_val < 0.05)
  })
})
print(p25_p75_gap_test)


      return(data.frame(crop = crop, tau = taus[i], p25_minus_p75_trimmed = point_diff,
                        p_value_boot = NA_real_, significant_05 = NA))
    }
    p_val <- if (point_diff < 0) 2 * mean(diff_vec >= 0) else 2 * mean(diff_vec <= 0)
    p_val <- min(p_val, 1)
    data.frame(crop = crop, tau = taus[i], p25_minus_p75_trimmed = point_diff,
               p_value_boot = round(p_val, 3), significant_05 = p_val < 0.05)
  })
})

